---
import { SOCIAL_LINKS } from '../data/siteData';

interface Props {
  variant?: 'light' | 'dark';
}

const { variant = 'light' } = Astro.props;

const buttonStyles = variant === 'light'
  ? 'border-white/30 text-white hover:bg-white hover:text-navy-deep'
  : 'border-line text-ink hover:bg-navy-deep hover:text-white';
---

<div class="flex gap-3">
  {SOCIAL_LINKS.map((s) => (
    <a
      href={s.url}
      class={`w-11 h-11 flex items-center justify-center border transition-colors ${buttonStyles}`}
      aria-label={s.name}
      title={s.name}
    >
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill={s.fill} aria-hidden="true">
        <path d={s.path} />
      </svg>
    </a>
  ))}
</div>
