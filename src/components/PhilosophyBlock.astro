---
interface Props {
  variant?: 'full' | 'compact';
}

const { variant = 'full' } = Astro.props;

const QUOTES = [
  {
    text: "Arise, awake, and stop not till the goal is reached.",
    subtext: "Empowering youth to achieve strength, self-reliance, and purpose.",
    category: "Action"
  },
  {
    text: "Service to man is service to God. In serving humanity, we worship the Divine.",
    subtext: "The core philosophy behind our social, healthcare, and community welfare programs.",
    category: "Compassion"
  },
  {
    text: "Education is the manifestation of the perfection already in man.",
    subtext: "Guiding our Gyannodaya learning centers to awaken wisdom in every child.",
    category: "Education"
  },
  {
    text: "We want that education by which character is formed, strength of mind is increased, and the intellect is expanded.",
    subtext: "Combining sports, culture, and ethics for nation building.",
    category: "Character"
  }
];
---

<section class="section bg-mist border-t border-b border-line">
  <div class="shell">
    <div class="max-w-2xl mx-auto text-center mb-14" data-animate="fade-up">
      <span class="kicker mb-3 block">Our Guiding Philosophy</span>
      <h2 class="text-3xl md:text-4xl font-display font-semibold text-ink mb-4">
        Inspired by Swami Vivekananda
      </h2>
      <div class="w-12 h-0.5 bg-saffron mx-auto mb-4"></div>
      <p class="text-ink-faint text-base leading-relaxed">
        Every initiative at Sarvagun Gyannodaya Trust is rooted in his timeless vision of human empowerment, youth vigor, character education, and selfless service.
      </p>
    </div>

    <!-- Quotes — bespoke editorial quote cards -->
    <div class="grid md:grid-cols-2 gap-6 max-w-4xl mx-auto" data-animate="stagger">
      {QUOTES.map((q) => (
        <div class="bg-white border border-line p-8 relative group hover:border-amber-700/40 transition-all duration-300">
          <div class="flex items-center justify-between mb-4">
            <span class="text-[0.7rem] font-bold uppercase tracking-[0.15em] text-saffron-deep bg-saffron-light px-2.5 py-1 border border-amber-800/10">
              {q.category}
            </span>
            <span class="text-3xl font-display text-stone-300 group-hover:text-amber-700/30 transition-colors select-none">&ldquo;</span>
          </div>
          <blockquote class="text-lg md:text-xl font-display italic text-ink leading-snug mb-5">
            {q.text}
          </blockquote>
          <p class="text-ink-faint text-sm border-t border-line/80 pt-4 leading-relaxed">
            {q.subtext}
          </p>
        </div>
      ))}
    </div>

    {variant === 'full' && (
      <div class="mt-14 text-center border-t border-line/60 pt-8 max-w-xl mx-auto">
        <p class="font-display text-xl italic text-ink mb-2">
          &ldquo;They alone live, who live for others.&rdquo;
        </p>
        <p class="text-saffron-deep font-semibold text-xs uppercase tracking-widest">— Swami Vivekananda</p>
      </div>
    )}
  </div>
</section>
