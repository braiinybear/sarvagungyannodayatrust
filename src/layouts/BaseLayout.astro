---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Empowering Lives Through Education, Care & Community Development" } = Astro.props;

const navItems = [
  { label: "About", href: "/about" },
  { label: "Our Work", href: "/our-work" },
  { label: "Impact", href: "/impact" },
  { label: "Blog", href: "/blog" },
  { label: "Contact", href: "/contact" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title} | Sarvagya Gyanodaya Trust</title>
  </head>
  <body class="min-h-screen flex flex-col">
    <!-- Top bar: quote + contact -->
    <div class="bg-pine-deep text-paper">
      <div class="shell">
        <div class="flex items-center justify-between h-10 text-xs">
          <p class="font-display italic text-paper/85 tracking-wide">
            &ldquo;No one has ever become poor by giving.&rdquo;
          </p>
          <div class="hidden sm:flex items-center gap-7">
            <span class="tracking-[0.08em] text-paper/60">+91 [Phone Number]</span>
            <span class="tracking-[0.08em] text-paper/60">info@sarvagyagyanodayatrust.org</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Header -->
    <header class="sticky top-0 z-50 bg-paper/95 backdrop-blur-md border-b border-line">
      <div class="shell">
        <nav class="flex items-center justify-between h-[76px]">
          <!-- Logo -->
          <a href="/" class="flex items-center gap-3">
            <span class="text-[1.35rem] font-display font-semibold leading-none tracking-tight">
              Sarvagya<span class="text-saffron">.</span>
            </span>
            <span class="hidden sm:block text-[0.6rem] font-bold tracking-[0.22em] uppercase text-ink-faint pt-1">Gyanodaya Trust</span>
          </a>

          <!-- Desktop Nav -->
          <div class="hidden lg:flex items-center gap-8">
            {navItems.map((item) => (
              <a
                href={item.href}
                class="text-[0.78rem] font-semibold tracking-[0.08em] uppercase text-ink-soft hover:text-ink transition-colors"
              >
                {item.label}
              </a>
            ))}
          </div>

          <div class="flex items-center gap-3">
            <a href="/get-involved/donate" class="btn btn-primary !py-3 !px-6 text-[0.72rem]">Donate</a>

            <button
              id="menu-btn"
              class="lg:hidden p-2 text-ink"
              aria-label="Toggle menu"
            >
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16" />
              </svg>
            </button>
          </div>
        </nav>

        <!-- Mobile menu -->
        <div id="mobile-menu" class="hidden lg:hidden pb-5">
          <div class="flex flex-col gap-1">
            {navItems.map((item) => (
              <a
                href={item.href}
                class="px-3 py-3 text-[0.8rem] font-semibold uppercase tracking-[0.1em] text-ink-soft hover:text-ink transition-colors"
              >
                {item.label}
              </a>
            ))}
          </div>
        </div>
      </div>
    </header>

    <!-- Main -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-pine-deep text-paper">
      <div class="shell pt-20 pb-12">
        <div class="max-w-3xl mb-16">
          <p class="font-display text-3xl md:text-[2.75rem] leading-[1.15] tracking-tight">
            Education, dignity, and care — for every life.
          </p>
          <a href="/get-involved/donate" class="link-arrow link-arrow-light mt-8">Donate today</a>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-10 border-t border-paper/10 pt-12">
          <div class="col-span-2 md:col-span-1">
            <p class="font-display text-xl mb-3">Sarvagya<span class="text-saffron">.</span></p>
            <p class="text-paper/55 text-sm leading-relaxed mb-4">
              Empowering lives through education, elderly care, and community development.
            </p>
            <p class="text-paper/40 text-xs">Established by Mr. Rahul Rawat</p>
          </div>

          <div>
            <h4 class="text-[0.68rem] font-bold tracking-[0.2em] uppercase text-paper/40 mb-5">Explore</h4>
            <ul class="space-y-3">
              <li><a href="/about" class="text-paper/75 hover:text-paper text-sm transition-colors">About</a></li>
              <li><a href="/our-work" class="text-paper/75 hover:text-paper text-sm transition-colors">Our Work</a></li>
              <li><a href="/impact" class="text-paper/75 hover:text-paper text-sm transition-colors">Impact & Reports</a></li>
              <li><a href="/blog" class="text-paper/75 hover:text-paper text-sm transition-colors">News & Stories</a></li>
            </ul>
          </div>

          <div>
            <h4 class="text-[0.68rem] font-bold tracking-[0.2em] uppercase text-paper/40 mb-5">Programs</h4>
            <ul class="space-y-3">
              <li><a href="/our-work/education" class="text-paper/75 hover:text-paper text-sm transition-colors">Education & Digital Literacy</a></li>
              <li><a href="/our-work/elderly-care" class="text-paper/75 hover:text-paper text-sm transition-colors">Elderly Care & Support</a></li>
              <li><a href="/our-work/community" class="text-paper/75 hover:text-paper text-sm transition-colors">Community Development</a></li>
            </ul>
          </div>

          <div>
            <h4 class="text-[0.68rem] font-bold tracking-[0.2em] uppercase text-paper/40 mb-5">Trust</h4>
            <ul class="space-y-3 text-sm text-paper/75">
              <li>Registered under Indian Trust Act, 1882</li>
              <li>Reg. No: [XXXXXX]</li>
              <li>80G / 12A — Donations tax-exempt</li>
            </ul>
          </div>
        </div>

        <div class="mt-14 pt-8 border-t border-paper/10 flex flex-col md:flex-row justify-between items-start gap-5">
          <p class="text-paper/40 text-xs">© 2026 Sarvagya Gyanodaya Trust. All rights reserved.</p>
          <div class="flex gap-3">
            {[
              {
                name: "Facebook",
                fill: "#1877F2",
                path: "M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z",
              },
              {
                name: "Instagram",
                fill: "#E4405F",
                path: "M12 0C8.74 0 8.333.015 7.053.072 5.775.132 4.905.333 4.14.63c-.789.306-1.459.717-2.126 1.384S.935 3.35.63 4.14C.333 4.905.131 5.775.072 7.053.012 8.333 0 8.74 0 12s.015 3.667.072 4.947c.06 1.277.261 2.148.558 2.913.306.788.717 1.459 1.384 2.126.667.666 1.336 1.079 2.126 1.384.766.296 1.636.499 2.913.558C8.333 23.988 8.74 24 12 24s3.667-.015 4.947-.072c1.277-.06 2.148-.262 2.913-.558.788-.306 1.459-.718 2.126-1.384.666-.667 1.079-1.335 1.384-2.126.296-.765.499-1.636.558-2.913.06-1.28.072-1.687.072-4.947s-.015-3.667-.072-4.947c-.06-1.277-.262-2.149-.558-2.913-.306-.789-.718-1.459-1.384-2.126C21.319 1.347 20.651.935 19.86.63c-.765-.297-1.636-.499-2.913-.558C15.667.012 15.26 0 12 0zm0 2.16c3.203 0 3.585.016 4.85.071 1.17.055 1.805.249 2.227.415.562.217.96.477 1.382.896.419.42.679.819.896 1.381.164.422.36 1.057.413 2.227.057 1.266.07 1.646.07 4.85s-.015 3.585-.074 4.85c-.061 1.17-.256 1.805-.421 2.227-.224.562-.479.96-.899 1.382-.419.419-.824.679-1.38.896-.42.164-1.065.36-2.235.413-1.274.057-1.649.07-4.859.07-3.211 0-3.586-.015-4.859-.074-1.171-.061-1.816-.256-2.236-.421-.569-.224-.96-.479-1.379-.899-.421-.419-.69-.824-.9-1.38-.165-.42-.359-1.065-.42-2.235-.045-1.26-.061-1.649-.061-4.844 0-3.196.016-3.586.061-4.861.061-1.17.255-1.814.42-2.234.21-.57.479-.96.9-1.381.419-.419.81-.689 1.379-.898.42-.166 1.051-.361 2.221-.421 1.275-.045 1.65-.06 4.859-.06l.045.03zm0 3.678c-3.405 0-6.162 2.76-6.162 6.162 0 3.405 2.76 6.162 6.162 6.162 3.405 0 6.162-2.76 6.162-6.162 0-3.405-2.76-6.162-6.162-6.162zM12 16c-2.21 0-4-1.79-4-4s1.79-4 4-4 4 1.79 4 4-1.79 4-4 4zm7.846-10.405c0 .795-.646 1.44-1.44 1.44-.795 0-1.44-.646-1.44-1.44 0-.794.646-1.439 1.44-1.439.793-.001 1.44.645 1.44 1.439z",
              },
              {
                name: "LinkedIn",
                fill: "#0A66C2",
                path: "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zM7.119 20.452H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z",
              },
              {
                name: "YouTube",
                fill: "#FF0000",
                path: "M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z",
              },
            ].map((s) => (
              <a
                href="#"
                class="w-11 h-11 flex items-center justify-center border border-paper/25 hover:bg-paper hover:text-pine-deep transition-colors"
                aria-label={s.name}
                title={s.name}
              >
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill={s.fill} aria-hidden="true">
                  <path d={s.path} />
                </svg>
              </a>
            ))}
          </div>
        </div>
      </div>
    </footer>

    <script>
      const btn = document.getElementById('menu-btn');
      const menu = document.getElementById('mobile-menu');
      btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));
    </script>
  </body>
</html>