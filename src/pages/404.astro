---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found">
  <section class="section bg-mist min-h-[60vh] flex items-center">
    <div class="shell text-center">
      <span class="font-display text-8xl md:text-9xl text-saffron block mb-4">404</span>
      <h1 class="font-display text-3xl md:text-5xl mb-6">Page Not Found</h1>
      <p class="text-ink-soft text-lg mb-8 max-w-md mx-auto leading-relaxed">
        The page you are looking for might have been moved, renamed, or is temporarily unavailable.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/" class="btn btn-primary">Back to Home</a>
        <a href="/our-work" class="btn btn-ghost">Explore Our Work</a>
      </div>
    </div>
  </section>
</BaseLayout>