---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found">
  <section class="section bg-mist min-h-[60vh] flex items-center">
    <div class="shell text-center">
      <p class="font-display text-[7rem] md:text-[10rem] leading-none text-pine/15 select-none">404</p>
      <h1 class="text-4xl md:text-5xl text-ink mb-4">Page Not Found</h1>
      <p class="text-ink-soft mb-10 max-w-xl mx-auto">
        The page you're looking for doesn't exist or has been moved.
        But don't worry — there's still plenty of good work to explore.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/" class="btn btn-primary">Back to Home</a>
        <a href="/our-work" class="btn btn-ghost">Explore Our Work</a>
      </div>
    </div>
  </section>
</BaseLayout>