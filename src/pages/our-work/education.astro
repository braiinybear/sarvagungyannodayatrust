---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Education & Digital Literacy" description="Education and digital literacy programs by Sarvagun Gyannodaya Trust">
  <!-- Hero -->
  <section class="section bg-mist">
    <div class="shell">
      <nav class="text-sm text-ink-faint mb-8">
        <a href="/our-work" class="hover:text-pine">Our Work</a>
        <span class="mx-2">/</span>
        <span class="text-ink-soft">Education &amp; Digital Literacy</span>
      </nav>
      <div class="grid lg:grid-cols-2 gap-14 items-center">
        <div>
          <p class="kicker mb-5">Program 01</p>
          <h1 class="text-4xl md:text-6xl text-ink mb-6 text-balance">Education &amp; Digital Literacy</h1>
          <p class="text-lg md:text-xl text-ink-soft mb-8">
            Opening doors to opportunity through knowledge and technology.
          </p>
          <div class="flex flex-wrap gap-4">
            <a href="/get-involved/donate" class="btn btn-primary">Support This Program</a>
            <a href="/get-involved/volunteer" class="btn btn-ghost">Volunteer</a>
          </div>
        </div>
        <div class="img-frame aspect-[4/3]">
          <img
            src="https://images.pexels.com/photos/6217466/pexels-photo-6217466.jpeg?auto=compress&cs=tinysrgb&w=1200"
            alt="Children using a computer together"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Programs List -->
  <section class="section bg-paper">
    <div class="shell">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-14">
        <div>
          <p class="kicker mb-4">Inside the Program</p>
          <h2 class="text-3xl md:text-5xl text-ink">What we offer</h2>
        </div>
      </div>
      <div class="grid md:grid-cols-2 gap-7">
        <div class="card p-8">
          <div class="w-12 h-12 bg-pine/10 rounded-none flex items-center justify-center mb-5 text-pine">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
              <rect x="2" y="4" width="20" height="13" rx="2" />
              <path stroke-linecap="round" d="M8 21h8M12 17v4" />
            </svg>
          </div>
          <h3 class="font-display text-xl mb-3">Digital Literacy Centers</h3>
          <p class="text-ink-soft text-sm">
            Community computer hubs providing free digital skills training — from basic
            computer use to internet safety and online services.
          </p>
        </div>
        <div class="card p-8">
          <div class="w-12 h-12 bg-pine/10 rounded-none flex items-center justify-center mb-5 text-pine">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
              <path d="M12 3l2.7 5.5 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1L3.2 9.4l6.1-.9L12 3z" />
            </svg>
          </div>
          <h3 class="font-display text-xl mb-3">Scholarship Programs</h3>
          <p class="text-ink-soft text-sm">
            Financial support covering school fees, books, and supplies for talented
            students from underprivileged backgrounds.
          </p>
        </div>
        <div class="card p-8">
          <div class="w-12 h-12 bg-pine/10 rounded-none flex items-center justify-center mb-5 text-pine">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
              <path stroke-linecap="round" d="M12 7v10M7 12h10" />
              <circle cx="12" cy="12" r="9" />
            </svg>
          </div>
          <h3 class="font-display text-xl mb-3">After-School Tutoring</h3>
          <p class="text-ink-soft text-sm">
            Extra academic support and homework help to keep children in school
            and performing at their best.
          </p>
        </div>
        <div class="card p-8">
          <div class="w-12 h-12 bg-pine/10 rounded-none flex items-center justify-center mb-5 text-pine">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
              <rect x="6" y="2" width="12" height="20" rx="2" />
              <path stroke-linecap="round" d="M11 18h2" />
            </svg>
          </div>
          <h3 class="font-display text-xl mb-3">Computer Training for Youth</h3>
          <p class="text-ink-soft text-sm">
            Job-ready digital skills for young people: office software, online
            communication, and e-commerce basics.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Video: In the classroom -->
  <section class="section bg-mist">
    <div class="shell">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-12">
        <div>
          <p class="kicker mb-4">In the Classroom</p>
          <h2 class="text-3xl md:text-5xl text-ink">Watch it happen</h2>
        </div>
        <p class="text-ink-soft text-lg max-w-md">Students doing their schoolwork at one of our learning centers.</p>
      </div>
      <video
        class="w-full aspect-video object-cover"
        src="https://videos.pexels.com/video-files/5200020/5200020-hd_1920_1080_25fps.mp4"
        poster="https://images.pexels.com/videos/5200020/pexels-photo-5200020.jpeg?auto=compress&cs=tinysrgb&w=1600"
        controls
        preload="metadata"
      ></video>
    </div>
  </section>

  <!-- Impact -->
  <section class="section bg-pine text-paper">
    <div class="shell">
      <p class="kicker !text-saffron mb-4">Program Impact</p>
      <h2 class="text-3xl md:text-4xl mb-12">The difference so far</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-px bg-pine">
        <div class="py-8 text-center bg-pine">
          <div class="stat-number !text-saffron">[X]+</div>
          <div class="stat-label !text-paper/70">Students Enrolled</div>
        </div>
        <div class="py-8 text-center bg-pine">
          <div class="stat-number !text-saffron">[X]</div>
          <div class="stat-label !text-paper/70">Digital Hubs Established</div>
        </div>
        <div class="py-8 text-center bg-pine">
          <div class="stat-number !text-saffron">[X]%</div>
          <div class="stat-label !text-paper/70">Learning Improvement</div>
        </div>
        <div class="py-8 text-center bg-pine">
          <div class="stat-number !text-saffron">[X]</div>
          <div class="stat-label !text-paper/70">Scholarships Awarded</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stories -->
  <section class="section bg-paper">
    <div class="shell grid lg:grid-cols-2 gap-14 items-center">
      <div class="img-frame aspect-[4/3]">
        <img
          src="https://images.pexels.com/photos/14180701/pexels-photo-14180701.jpeg?auto=compress&cs=tinysrgb&w=1000"
          alt="Student smiling in class"
          loading="lazy"
        />
      </div>
      <div>
        <p class="kicker mb-4">A Story of Change</p>
        <blockquote class="font-display text-2xl md:text-3xl leading-snug text-ink mb-8">
          "Before this program, I had never used a computer. Now I teach my grandchildren
          and help my village access digital services."
        </blockquote>
        <p class="font-semibold">Kamla Devi</p>
        <p class="text-ink-faint text-sm">Age 67, Uttarakhand</p>
        <a href="/impact" class="inline-flex items-center gap-2 text-pine font-semibold mt-8 hover:gap-3 transition-all">
          More Stories <span aria-hidden>→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section bg-pine-deep text-center text-paper">
    <div class="shell max-w-2xl">
      <h2 class="text-3xl md:text-4xl mb-4">Help a Child Learn Today</h2>
      <p class="text-paper/75 mb-8">
        Just ₹500 supports a child's school supplies for a month. Together, we can
        open doors to a brighter future.
      </p>
      <a href="/get-involved/donate" class="btn btn-primary">Donate Now</a>
    </div>
  </section>
</BaseLayout>