---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { SITE_INFO } from '../../data/siteData';
import { PROGRAMS } from '../../data/programsData';

const program = PROGRAMS.find(p => p.id === 'education') || PROGRAMS[0];

const OFFERS = [
  {
    title: "Digital Literacy Centers",
    desc: "Community computer hubs providing free digital skills training — from basic computer use to internet safety and online services.",
    icon: "M2 4h20v13H2z M8 21h8 M12 17v4"
  },
  {
    title: "Scholarship Programs",
    desc: "Financial support covering school fees, books, and supplies for talented students from underprivileged backgrounds.",
    icon: "M12 3l2.7 5.5 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1L3.2 9.4l6.1-.9L12 3z"
  },
  {
    title: "After-School Tutoring",
    desc: "Extra academic support and homework help to keep children in school and performing at their best.",
    icon: "M12 7v10M7 12h10 M12 3a9 9 0 100 18 9 9 0 000-18z"
  },
  {
    title: "Computer Training for Youth",
    desc: "Job-ready digital skills for young people: office software, online communication, and e-commerce basics.",
    icon: "M6 2h12v20H6z M11 18h2"
  }
];
---

<BaseLayout title={program.title} description={`${program.title} by ${SITE_INFO.name}`}>
  <!-- Page Hero -->
  <PageHero
    kicker={`Program ${program.number}`}
    title={program.title}
    description={program.tagline}
    breadcrumbs={[
      { label: "Our Work", href: "/our-work" },
      { label: program.title }
    ]}
  >
    <div class="mt-8 flex flex-wrap gap-4">
      <a href="/get-involved/donate" class="btn btn-primary">Support This Program</a>
      <a href="/get-involved/volunteer" class="btn btn-ghost">Volunteer</a>
    </div>
  </PageHero>

  <!-- Overview Section -->
  <section class="section bg-paper">
    <div class="shell grid lg:grid-cols-2 gap-14 items-center">
      <div>
        <p class="kicker mb-4">Inside the Program</p>
        <h2 class="text-3xl md:text-5xl text-ink mb-6 font-display">What we offer</h2>
        <p class="text-ink-soft leading-relaxed mb-6">{program.fullDescription}</p>
        <ul class="space-y-3 mb-8">
          {program.highlights?.map((highlight) => (
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-saffron mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-ink-soft">{highlight}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="overflow-hidden aspect-[4/3] border border-line">
        <img
          src="https://images.pexels.com/photos/6217466/pexels-photo-6217466.jpeg?auto=compress&cs=tinysrgb&w=1200"
          alt="Children using a computer together"
          loading="lazy"
          class="w-full h-full object-cover"
        />
      </div>
    </div>
  </section>

  <!-- Offerings Grid -->
  <section class="section bg-mist">
    <div class="shell">
      <div class="grid md:grid-cols-2 gap-7">
        {OFFERS.map((item) => (
          <div class="card p-8 border border-line">
            <div class="w-12 h-12 bg-pine/10 flex items-center justify-center mb-5 text-pine">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
              </svg>
            </div>
            <h3 class="font-display text-xl mb-3">{item.title}</h3>
            <p class="text-ink-soft text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Video Demonstration -->
  <section class="section bg-paper">
    <div class="shell">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-12">
        <div>
          <p class="kicker mb-4">In the Classroom</p>
          <h2 class="text-3xl md:text-5xl text-ink font-display">Watch it happen</h2>
        </div>
        <p class="text-ink-soft text-lg max-w-md">Students doing their schoolwork at one of our learning centers.</p>
      </div>
      <video
        class="w-full aspect-video object-cover"
        src="https://videos.pexels.com/video-files/5200020/5200020-hd_1920_1080_25fps.mp4"
        poster="https://images.pexels.com/videos/5200020/pexels-photo-5200020.jpeg?auto=compress&cs=tinysrgb&w=1600"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
      ></video>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="section bg-pine-deep text-center text-paper">
    <div class="shell max-w-2xl">
      <h2 class="text-3xl md:text-4xl mb-4 font-display">Help a Child Learn Today</h2>
      <p class="text-paper/75 mb-8 leading-relaxed">
        Just ₹500 supports a child's school supplies for a month. Together, we can open doors to a brighter future.
      </p>
      <a href="/get-involved/donate" class="btn btn-accent">Donate Now</a>
    </div>
  </section>
</BaseLayout>