---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { SITE_INFO } from '../../data/siteData';
import { PROGRAMS } from '../../data/programsData';

const program = PROGRAMS.find(p => p.id === 'community') || PROGRAMS[2];

const OFFERS = [
  {
    title: "Rural Infrastructure",
    desc: "Small-scale projects like water facilities, classroom repairs, and community spaces that improve daily life.",
    icon: "M3 21V9l6-5 6 5v12 M9 21v-6h6v6"
  },
  {
    title: "Livelihood Training",
    desc: "Skill development and vocational training that help families build sustainable incomes.",
    icon: "M12 3v2M12 19v2M3 12h2M19 12h2 M5.6 5.6l1.4 1.4M17 17l1.4 1.4"
  },
  {
    title: "Women's Empowerment",
    desc: "Self-help groups, financial literacy, and income generation initiatives for women in rural areas.",
    icon: "M12 21c-4 0-7-1.5-7-4.5S8 12 12 12s7 1.5 7 4.5S16 21 12 21z M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8z"
  },
  {
    title: "Health & Sanitation Drives",
    desc: "Awareness campaigns, cleanliness drives, and access to safe water and sanitation facilities.",
    icon: "M12 3c3 3.5 5 6 5 9a5 5 0 0 1-10 0c0-3 2-5.5 5-9z"
  }
];
---

<BaseLayout title={program.title} description={`${program.title} by ${SITE_INFO.name}`}>
  <!-- Page Hero -->
  <PageHero
    kicker={`Program ${program.number}`}
    title={program.title}
    description={program.tagline}
    breadcrumbs={[
      { label: "Our Work", href: "/our-work" },
      { label: program.title }
    ]}
  >
    <div class="mt-8 flex flex-wrap gap-4">
      <a href="/get-involved/donate" class="btn btn-primary">Support This Program</a>
      <a href="/get-involved/partner" class="btn btn-ghost">Partner With Us</a>
    </div>
  </PageHero>

  <!-- Overview Section -->
  <section class="section bg-paper">
    <div class="shell grid lg:grid-cols-2 gap-14 items-center">
      <div>
        <p class="kicker mb-4">Inside the Program</p>
        <h2 class="text-3xl md:text-5xl text-ink mb-6 font-display">What we offer</h2>
        <p class="text-ink-soft leading-relaxed mb-6">{program.fullDescription}</p>
        <ul class="space-y-3 mb-8">
          {program.highlights?.map((highlight) => (
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-saffron mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-ink-soft">{highlight}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="overflow-hidden aspect-[4/3] border border-line">
        <img
          src="https://images.pexels.com/photos/13520612/pexels-photo-13520612.jpeg?auto=compress&cs=tinysrgb&w=1200"
          alt="Rural village scene"
          loading="lazy"
          class="w-full h-full object-cover"
        />
      </div>
    </div>
  </section>

  <!-- Offerings Grid -->
  <section class="section bg-mist">
    <div class="shell">
      <div class="grid md:grid-cols-2 gap-7">
        {OFFERS.map((item) => (
          <div class="card p-8 border border-line">
            <div class="w-12 h-12 bg-ember/10 flex items-center justify-center mb-5 text-ember">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
              </svg>
            </div>
            <h3 class="font-display text-xl mb-3">{item.title}</h3>
            <p class="text-ink-soft text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Video Section -->
  <section class="section bg-paper">
    <div class="shell">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-12">
        <div>
          <p class="kicker mb-4">Life in Our Villages</p>
          <h2 class="text-3xl md:text-5xl text-ink font-display">Where work begins</h2>
        </div>
        <p class="text-ink-soft text-lg max-w-md">Rural roads and daily life — the communities our programs walk with.</p>
      </div>
      <video
        class="w-full aspect-video object-cover"
        src="https://videos.pexels.com/video-files/4684304/4684304-hd_1920_1080_25fps.mp4"
        poster="https://images.pexels.com/videos/4684304/pexels-photo-4684304.jpeg?auto=compress&cs=tinysrgb&w=1600"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
      ></video>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="section bg-pine-deep text-center text-paper">
    <div class="shell max-w-2xl">
      <h2 class="text-3xl md:text-4xl mb-4 font-display">Build Stronger Communities</h2>
      <p class="text-paper/75 mb-8 leading-relaxed">
        Partner with us to fund community development projects with measurable impact.
      </p>
      <a href="/get-involved/partner" class="btn btn-accent">Partner With Us</a>
    </div>
  </section>
</BaseLayout>