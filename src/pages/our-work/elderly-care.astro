---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Elderly Care & Support" description="Elderly care and support programs by Sarvagya Gyanodaya Trust">
  <!-- Hero -->
  <section class="section bg-mist">
    <div class="shell">
      <nav class="text-sm text-ink-faint mb-8">
        <a href="/our-work" class="hover:text-pine">Our Work</a>
        <span class="mx-2">/</span>
        <span class="text-ink-soft">Elderly Care &amp; Support</span>
      </nav>
      <div class="grid lg:grid-cols-2 gap-14 items-center">
        <div>
          <p class="kicker mb-5">Program 02</p>
          <h1 class="text-4xl md:text-6xl text-ink mb-6 text-balance">Elderly Care &amp; Support</h1>
          <p class="text-lg md:text-xl text-ink-soft mb-8">
            Giving our seniors the healthcare, companionship, and dignity they deserve.
          </p>
          <div class="flex flex-wrap gap-4">
            <a href="/get-involved/donate" class="btn btn-primary">Support This Program</a>
            <a href="/get-involved/volunteer" class="btn btn-ghost">Volunteer</a>
          </div>
        </div>
        <div class="img-frame aspect-[4/3]">
          <img
            src="https://images.pexels.com/photos/6406419/pexels-photo-6406419.jpeg?auto=compress&cs=tinysrgb&w=1200"
            alt="Elderly person smiling"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Programs List -->
  <section class="section bg-paper">
    <div class="shell">
      <div class="mb-14">
        <p class="kicker mb-4">Inside the Program</p>
        <h2 class="text-3xl md:text-5xl text-ink">What we offer</h2>
      </div>
      <div class="grid md:grid-cols-2 gap-7">
        <div class="card p-8">
          <div class="w-12 h-12 bg-saffron/15 rounded-none flex items-center justify-center mb-5 text-saffron">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
              <path stroke-linecap="round" d="M12 21s-7-4.6-9.2-9A5.4 5.4 0 0 1 12 6.3 5.4 5.4 0 0 1 21.2 12C19 16.4 12 21 12 21z" />
            </svg>
          </div>
          <h3 class="font-display text-xl mb-3">Healthcare Assistance</h3>
          <p class="text-ink-soft text-sm">
            Regular check-ups, medicine support, and coordination with medical
            camps for elderly people in our communities.
          </p>
        </div>
        <div class="card p-8">
          <div class="w-12 h-12 bg-saffron/15 rounded-none flex items-center justify-center mb-5 text-saffron">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
              <path stroke-linecap="round" d="M4 12a8 8 0 0 1 16 0M8 12a4 4 0 0 1 8 0M10 12a2 2 0 0 1 4 0" />
            </svg>
          </div>
          <h3 class="font-display text-xl mb-3">Companionship Programs</h3>
          <p class="text-ink-soft text-sm">
            Regular visits, conversations, and community gatherings to tackle
            loneliness and keep seniors connected.
          </p>
        </div>
        <div class="card p-8">
          <div class="w-12 h-12 bg-saffron/15 rounded-none flex items-center justify-center mb-5 text-saffron">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
              <path stroke-linecap="round" d="M9 12l2 2 4-4" />
              <path d="M12 3l7 3v5c0 5-3.2 8.4-7 10-3.8-1.6-7-5-7-10V6l7-3z" />
            </svg>
          </div>
          <h3 class="font-display text-xl mb-3">Retirement Planning Support</h3>
          <p class="text-ink-soft text-sm">
            Guidance on pensions, government schemes, and financial planning
            for a secure old age.
          </p>
        </div>
        <div class="card p-8">
          <div class="w-12 h-12 bg-saffron/15 rounded-none flex items-center justify-center mb-5 text-saffron">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
              <path d="M12 3l1.8 4.6L18.5 8l-3.5 3 1 4.7-4-2.5-4 2.5 1-4.7L5.5 8l4.7-.4L12 3z" />
              <path stroke-linecap="round" d="M6 20h12" />
            </svg>
          </div>
          <h3 class="font-display text-xl mb-3">Medical Camps</h3>
          <p class="text-ink-soft text-sm">
            Free health check-up camps organized with local doctors for
            senior citizens in rural areas.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Video: A moment with our elders -->
  <section class="section bg-mist">
    <div class="shell">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-12">
        <div>
          <p class="kicker mb-4">A Moment with Our Elders</p>
          <h2 class="text-3xl md:text-5xl text-ink">Companionship, by the hour</h2>
        </div>
        <p class="text-ink-soft text-lg max-w-md">The quiet dignity of a life lived fully — and never alone.</p>
      </div>
      <video
        class="w-full aspect-video object-cover"
        src="https://videos.pexels.com/video-files/5327875/5327875-hd_1920_1080_25fps.mp4"
        poster="https://images.pexels.com/videos/5327875/20-25-years-old-man-indian-people-old-old-age-5327875.jpeg?auto=compress&cs=tinysrgb&w=1600"
        controls
        preload="metadata"
      ></video>
    </div>
  </section>

  <!-- Impact -->
  <section class="section bg-pine text-paper">
    <div class="shell">
      <p class="kicker !text-saffron mb-4">Program Impact</p>
      <h2 class="text-3xl md:text-4xl mb-12">The difference so far</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-px bg-pine">
        <div class="py-8 text-center bg-pine">
          <div class="stat-number !text-saffron">[X]+</div>
          <div class="stat-label !text-paper/70">Elderly Beneficiaries</div>
        </div>
        <div class="py-8 text-center bg-pine">
          <div class="stat-number !text-saffron">[X]</div>
          <div class="stat-label !text-paper/70">Medical Camps Organized</div>
        </div>
        <div class="py-8 text-center bg-pine">
          <div class="stat-number !text-saffron">[X]</div>
          <div class="stat-label !text-paper/70">Companionship Visits</div>
        </div>
        <div class="py-8 text-center bg-pine">
          <div class="stat-number !text-saffron">[X]</div>
          <div class="stat-label !text-paper/70">Seniors Supported</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stories -->
  <section class="section bg-paper">
    <div class="shell grid lg:grid-cols-2 gap-14 items-center">
      <div class="img-frame aspect-[4/3]">
        <img
          src="https://images.pexels.com/photos/11359605/pexels-photo-11359605.jpeg?auto=compress&cs=tinysrgb&w=1000"
          alt="Elderly man smiling"
          loading="lazy"
        />
      </div>
      <div>
        <p class="kicker mb-4">A Story of Change</p>
        <blockquote class="font-display text-2xl md:text-3xl leading-snug text-ink mb-8">
          "I thought I would spend my days alone. Now I look forward to every visit
          from the companions — they have become like my own family."
        </blockquote>
        <p class="font-semibold">Ram Prasad</p>
        <p class="text-ink-faint text-sm">Age 79, Madhya Pradesh</p>
        <a href="/impact" class="inline-flex items-center gap-2 text-pine font-semibold mt-8 hover:gap-3 transition-all">
          More Stories <span aria-hidden>→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section bg-pine-deep text-center text-paper">
    <div class="shell max-w-2xl">
      <h2 class="text-3xl md:text-4xl mb-4">Give Seniors the Joy of Company</h2>
      <p class="text-paper/75 mb-8">
        A small donation or a few hours of your time can brighten an elder's life.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/get-involved/donate" class="btn btn-primary">Donate Now</a>
        <a href="/get-involved/volunteer" class="btn btn-light">Become a Volunteer</a>
      </div>
    </div>
  </section>
</BaseLayout>