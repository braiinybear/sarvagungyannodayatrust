---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { SITE_INFO } from '../../data/siteData';
import { PROGRAMS } from '../../data/programsData';

const program = PROGRAMS.find(p => p.id === 'elderly-care') || PROGRAMS[1];

const OFFERS = [
  {
    title: "Healthcare Assistance",
    desc: "Regular check-ups, medicine support, and coordination with medical camps for elderly people in our communities.",
    icon: "M12 21s-7-4.6-9.2-9A5.4 5.4 0 0 1 12 6.3 5.4 5.4 0 0 1 21.2 12C19 16.4 12 21 12 21z"
  },
  {
    title: "Companionship Programs",
    desc: "Regular visits, conversations, and community gatherings to tackle loneliness and keep seniors connected.",
    icon: "M4 12a8 8 0 0 1 16 0M8 12a4 4 0 0 1 8 0M10 12a2 2 0 0 1 4 0"
  },
  {
    title: "Retirement & Pension Guidance",
    desc: "Guidance on pensions, government schemes, and financial documentation for a secure old age.",
    icon: "M9 12l2 2 4-4 M12 3l7 3v5c0 5-3.2 8.4-7 10-3.8-1.6-7-5-7-10V6l7-3z"
  },
  {
    title: "Medical Camps & Wellness",
    desc: "Free health check-up camps organized with local doctors for senior citizens in rural areas.",
    icon: "M12 3l1.8 4.6L18.5 8l-3.5 3 1 4.7-4-2.5-4 2.5 1-4.7L5.5 8l4.7-.4L12 3z M6 20h12"
  }
];
---

<BaseLayout title={program.title} description={`${program.title} by ${SITE_INFO.name}`}>
  <!-- Page Hero -->
  <PageHero
    kicker={`Program ${program.number}`}
    title={program.title}
    description={program.tagline}
    breadcrumbs={[
      { label: "Our Work", href: "/our-work" },
      { label: program.title }
    ]}
  >
    <div class="mt-8 flex flex-wrap gap-4">
      <a href="/get-involved/donate" class="btn btn-primary">Support This Program</a>
      <a href="/get-involved/volunteer" class="btn btn-ghost">Volunteer</a>
    </div>
  </PageHero>

  <!-- Overview Section -->
  <section class="section bg-paper">
    <div class="shell grid lg:grid-cols-2 gap-14 items-center">
      <div>
        <p class="kicker mb-4">Inside the Program</p>
        <h2 class="text-3xl md:text-5xl text-ink mb-6 font-display">What we offer</h2>
        <p class="text-ink-soft leading-relaxed mb-6">{program.fullDescription}</p>
        <ul class="space-y-3 mb-8">
          {program.highlights?.map((highlight) => (
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-saffron mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-ink-soft">{highlight}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="overflow-hidden aspect-[4/3] border border-line">
        <img
          src="https://images.pexels.com/photos/6406419/pexels-photo-6406419.jpeg?auto=compress&cs=tinysrgb&w=1200"
          alt="Elderly person smiling"
          loading="lazy"
          class="w-full h-full object-cover"
        />
      </div>
    </div>
  </section>

  <!-- Offerings Grid -->
  <section class="section bg-mist">
    <div class="shell">
      <div class="grid md:grid-cols-2 gap-7">
        {OFFERS.map((item) => (
          <div class="card p-8 border border-line">
            <div class="w-12 h-12 bg-saffron/15 flex items-center justify-center mb-5 text-saffron">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
              </svg>
            </div>
            <h3 class="font-display text-xl mb-3">{item.title}</h3>
            <p class="text-ink-soft text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Video Section -->
  <section class="section bg-paper">
    <div class="shell">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-12">
        <div>
          <p class="kicker mb-4">A Moment with Our Elders</p>
          <h2 class="text-3xl md:text-5xl text-ink font-display">Companionship, by the hour</h2>
        </div>
        <p class="text-ink-soft text-lg max-w-md">The quiet dignity of a life lived fully — and never alone.</p>
      </div>
      <video
        class="w-full aspect-video object-cover"
        src="https://videos.pexels.com/video-files/5327875/5327875-hd_1920_1080_25fps.mp4"
        poster="https://images.pexels.com/videos/5327875/20-25-years-old-man-indian-people-old-old-age-5327875.jpeg?auto=compress&cs=tinysrgb&w=1600"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
      ></video>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="section bg-pine-deep text-center text-paper">
    <div class="shell max-w-2xl">
      <h2 class="text-3xl md:text-4xl mb-4 font-display">Give Seniors the Joy of Company</h2>
      <p class="text-paper/75 mb-8 leading-relaxed">
        A small donation or a few hours of your time can brighten an elder's life.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/get-involved/donate" class="btn btn-accent">Donate Now</a>
        <a href="/get-involved/volunteer" class="btn btn-light">Become a Volunteer</a>
      </div>
    </div>
  </section>
</BaseLayout>