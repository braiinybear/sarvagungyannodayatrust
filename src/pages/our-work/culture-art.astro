---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { PROGRAMS } from '../../data/programsData';

const program = PROGRAMS.find(p => p.id === 'culture-art')!;

const cultureGallery = [
  { src: "/images/nation-building/cba21d87-8102-4556-9239-f1b6a9f25ef3.jpg", title: "Folk Weaving & Traditional Crafts", desc: "Supporting rural artisans preserving handloom heritage and indigenous weaving techniques." },
  { src: "/images/nation-building/bf3fa072-02d1-4922-bf52-0261e4a4ca8f.jpg", title: "Cultural Festivals & Performing Arts", desc: "Organizing folk music, classical dance, and regional theater for youth participation." },
  { src: "/images/nation-building/2f5a282e-db2a-485a-b5a0-a61f978d5d9b.jpg", title: "Heritage Education Workshops", desc: "Connecting schoolchildren with local history, traditional storytelling, and folk art forms." }
];
---

<BaseLayout title="Culture & Art — SARVAGUN Gyannodaya Trust" description="Preserving indigenous folk arts, traditional weaving, cultural heritage, and artisan livelihoods.">
  <PageHero
    kicker="Focus Area 06"
    title="Culture & Art Preservation"
    description="A nation that forgets its cultural roots forgets its soul. Documenting, reviving, and sustaining traditional Indian arts and heritage."
  />

  <!-- Motto Banner -->
  <div class="bg-amber-950 text-amber-100 py-4 px-6 border-b border-amber-900/40 text-center">
    <p class="font-display text-base md:text-lg tracking-wide font-medium">
      कला से संस्कृति • संस्कृति से चेतना • परम्परा से भावी संरक्षण
    </p>
  </div>

  <div class="bg-mist py-10 md:py-14">
    <div class="shell max-w-5xl mx-auto space-y-8 md:space-y-10">

      <!-- Section 1: Our Culture Vision -->
      <section class="grid lg:grid-cols-12 gap-10 items-center bg-white border border-line p-8 md:p-12" data-animate="fade-up">
        <div class="lg:col-span-7 space-y-5">
          <span class="text-xs font-bold uppercase tracking-[0.2em] text-saffron-deep">Our Heritage Vision</span>
          <h2 class="text-2xl md:text-3xl font-display font-semibold text-ink leading-tight">
            Reviving Folk Arts &amp; Rural Craftsmanship
          </h2>
          <p class="text-ink-soft text-base leading-relaxed">
            India's rural folk arts, handloom weaving, traditional music, and regional crafts represent thousands of years of living wisdom. At <strong>SARVAGUN Gyannodaya Trust</strong>, we are committed to documenting and protecting these endangered cultural treasures.
          </p>
          <p class="text-ink-soft text-base leading-relaxed">
            We organize artisan workshops, folk performance festivals, and fair-market connections for rural weavers and craftspeople.
          </p>
          <p class="text-ink-soft text-base leading-relaxed">
            By connecting young students with traditional masters, we ensure that India's artistic legacy remains alive and vibrant.
          </p>
        </div>
        <div class="lg:col-span-5 relative group overflow-hidden border border-line bg-mist">
          <img
            src={cultureGallery[0].src}
            alt={cultureGallery[0].title}
            class="w-full aspect-4/3 object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
            loading="eager"
          />
          <div class="p-3 bg-stone-50 border-t border-line text-xs text-ink-faint font-medium">
            📸 {cultureGallery[0].title}: {cultureGallery[0].desc}
          </div>
        </div>
      </section>

      <!-- Section 2: 5-Step Cultural Progression -->
      <section class="bg-white border border-line p-8 md:p-12 text-center" data-animate="fade-up">
        <span class="text-xs font-bold uppercase tracking-[0.2em] text-saffron-deep block mb-3">Cultural Pathway</span>
        <h2 class="text-2xl md:text-3xl font-display font-semibold text-ink mb-4">
          Preserving Living Traditions
        </h2>
        <p class="text-ink-soft text-base leading-relaxed max-w-3xl mx-auto mb-8">
          Culture is not a museum piece—it is a living current that nourishes self-identity, creativity, and community unity.
        </p>

        <!-- 5-Step Flow Strip -->
        <div class="bg-amber-950 text-white p-6 border border-amber-900/30 max-w-4xl mx-auto mb-8">
          <p class="text-xs font-semibold uppercase tracking-widest text-amber-400 mb-3">Cultural Preservation Journey</p>
          <div class="flex flex-wrap items-center justify-center gap-2 md:gap-4 text-sm md:text-base font-display font-semibold">
            <span class="bg-amber-900/60 px-3 py-1 border border-amber-700/40">Heritage</span>
            <span class="text-amber-400">→</span>
            <span class="bg-amber-900/60 px-3 py-1 border border-amber-700/40">Revival</span>
            <span class="text-amber-400">→</span>
            <span class="bg-amber-900/60 px-3 py-1 border border-amber-700/40">Craftsmanship</span>
            <span class="text-amber-400">→</span>
            <span class="bg-amber-900/60 px-3 py-1 border border-amber-700/40">Identity</span>
            <span class="text-amber-400">→</span>
            <span class="bg-amber-900/60 px-3 py-1 border border-amber-700/40 text-amber-200">Preservation</span>
          </div>
        </div>

        <p class="text-ink-faint text-sm max-w-2xl mx-auto italic">
          &ldquo;Culture is the widening of the mind and of the spirit.&rdquo;
        </p>
      </section>

      <!-- Section 3: Our 4 Cultural Pillars -->
      <section class="bg-white border border-line p-8 md:p-12" data-animate="fade-up">
        <div class="text-center max-w-2xl mx-auto mb-10">
          <span class="text-xs font-bold uppercase tracking-[0.2em] text-saffron-deep block mb-2">Heritage Pillars</span>
          <h2 class="text-2xl md:text-3xl font-display font-semibold text-ink mb-3">
            We Preserve. We Teach. We Showcase. We Support.
          </h2>
          <p class="text-ink-faint text-sm leading-relaxed">
            Supporting traditional artisans and connecting youth with India's profound cultural roots.
          </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="border border-line p-6 bg-mist hover:border-amber-700/40 transition-colors">
            <div class="text-saffron-deep font-bold text-lg mb-2">01. We Preserve</div>
            <p class="text-ink-soft text-xs leading-relaxed">
              Documenting endangered folk arts, traditional songs, weaving patterns, and local heritage sites.
            </p>
          </div>
          <div class="border border-line p-6 bg-mist hover:border-amber-700/40 transition-colors">
            <div class="text-saffron-deep font-bold text-lg mb-2">02. We Teach</div>
            <p class="text-ink-soft text-xs leading-relaxed">
              Master-led craft workshops teaching youth traditional loom weaving, pottery, and folk painting.
            </p>
          </div>
          <div class="border border-line p-6 bg-mist hover:border-amber-700/40 transition-colors">
            <div class="text-saffron-deep font-bold text-lg mb-2">03. We Showcase</div>
            <p class="text-ink-soft text-xs leading-relaxed">
              Organizing regional cultural festivals and youth talent showcases celebrating folk heritage.
            </p>
          </div>
          <div class="border border-line p-6 bg-mist hover:border-amber-700/40 transition-colors">
            <div class="text-saffron-deep font-bold text-lg mb-2">04. We Support</div>
            <p class="text-ink-soft text-xs leading-relaxed">
              Fostering artisan livelihoods and self-reliance for rural craft families.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 4: Photo Gallery Grid -->
      <section data-animate="fade-up">
        <div class="flex items-end justify-between mb-8">
          <div>
            <span class="text-xs font-bold uppercase tracking-[0.2em] text-saffron-deep block mb-1">Field Documentation</span>
            <h2 class="text-2xl font-display font-semibold text-ink">Glimpses of Cultural Initiatives</h2>
          </div>
        </div>
        <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-6" data-animate="stagger">
          {cultureGallery.map((img) => (
            <div class="bg-white border border-line overflow-hidden group hover:border-amber-700/40 transition-colors">
              <div class="relative overflow-hidden aspect-4/3 bg-mist">
                <img
                  src={img.src}
                  alt={img.title}
                  class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
                  loading="lazy"
                />
              </div>
              <div class="p-4">
                <h4 class="font-display font-semibold text-sm text-ink mb-1">{img.title}</h4>
                <p class="text-ink-faint text-xs leading-relaxed">{img.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Section 5: Closing Commitment -->
      <section class="bg-white border border-line p-8 md:p-12 text-center" data-animate="fade-up">
        <div class="my-6 p-8 bg-amber-950 text-amber-100 max-w-3xl mx-auto border border-amber-900/60 shadow-xs">
          <p class="text-xs font-bold uppercase tracking-widest text-amber-400 mb-3">Our Cultural Commitment</p>
          <blockquote class="font-display italic text-lg md:text-xl leading-relaxed text-white mb-4">
            &ldquo;In preserving our folk art and cultural roots, we preserve the soul of our nation.&rdquo;
          </blockquote>
          <p class="text-sm font-semibold text-amber-300">SARVAGUN Gyannodaya Trust</p>
          <p class="text-xs text-amber-400/80 mt-1">संस्कृति, कला और लोक परम्परा संरक्षण</p>
        </div>

        <div class="pt-4 flex flex-wrap justify-center gap-4">
          <a href="/get-involved/donate" class="btn btn-primary text-sm px-8 py-3.5">
            Support Rural Artisans
          </a>
          <a href="/contact" class="btn btn-outline-dark text-sm px-8 py-3.5">
            Partner for Cultural Events
          </a>
        </div>
      </section>

    </div>
  </div>
</BaseLayout>
