---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { SITE_INFO } from '../../data/siteData';
import { PROGRAMS } from '../../data/programsData';
---

<BaseLayout title="Our Work" description={`Discover ${SITE_INFO.name}'s programs in education, elderly care, and community development`}>
  <!-- Page Hero -->
  <PageHero
    kicker="What We Do"
    title="Three programs. One purpose."
    description="We don't just run programs — we transform lives. Explore how we're making a difference across three core areas."
  />

  <!-- Programs Grid -->
  <section class="section bg-paper">
    <div class="shell grid md:grid-cols-3 gap-7">
      {PROGRAMS.map((program) => (
        <article class="group card border border-line flex flex-col justify-between overflow-hidden">
          <div>
            <div class="overflow-hidden aspect-[4/3]">
              <img
                src={program.image}
                alt={program.imageAlt}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
              />
            </div>
            <div class="p-7">
              <span class="text-[0.68rem] font-bold tracking-[0.22em] uppercase text-saffron mb-2 block">Program {program.number}</span>
              <h2 class="font-display text-2xl mb-3">{program.title}</h2>
              <p class="text-ink-soft text-sm leading-relaxed">{program.description}</p>
            </div>
          </div>
          <div class="p-7 pt-0">
            <a href={program.href} class="inline-flex items-center gap-2 text-pine font-semibold text-sm hover:gap-3 transition-all">
              Explore Program <span aria-hidden>→</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="section bg-pine-deep text-center text-paper">
    <div class="shell max-w-2xl">
      <h2 class="text-3xl md:text-4xl mb-4 font-display">Want to Support Our Work?</h2>
      <p class="text-paper/75 mb-8 leading-relaxed">
        Every program is powered by people like you. Join us in creating lasting change.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/get-involved/donate" class="btn btn-accent">Donate Now</a>
        <a href="/get-involved/volunteer" class="btn btn-light">Become a Volunteer</a>
      </div>
    </div>
  </section>
</BaseLayout>