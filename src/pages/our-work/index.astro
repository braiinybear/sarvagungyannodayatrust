---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ProgramCard from '../../components/ProgramCard.astro';
import { PROGRAMS } from '../../data/programsData';
import { SITE_INFO } from '../../data/siteData';
---

<BaseLayout title="Our Work — 7 Pillars of Impact" description={`Discover the 7 core pillars of work by ${SITE_INFO.name}.`}>
  <PageHero
    kicker="Our Work"
    title="Seven Pillars, One Mission of Transformation"
    description="Working across Education, Social Care, Sports, Environment, Nation Building, Culture, and Spirituality to empower every human life."
    image="https://images.pexels.com/photos/8613089/pexels-photo-8613089.jpeg?auto=compress&cs=tinysrgb&w=1600"
  />

  <section class="section bg-white">
    <div class="shell">
      <div class="text-center max-w-3xl mx-auto mb-14">
        <h2 class="text-2xl md:text-3xl font-display font-semibold text-ink mb-4">
          Our Key Areas of Impact
        </h2>
        <p class="text-ink-faint text-base">
          Click on any pillar to explore our on-ground initiatives, field reports, and beneficiary transformation stories.
        </p>
      </div>

      <!-- 7 Pillars Grid -->
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {PROGRAMS.map((program) => (
          <ProgramCard program={program} />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>