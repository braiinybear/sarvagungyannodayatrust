---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { SITE_INFO } from '../../data/siteData';

const posts = [
  {
    title: "Digital Literacy Center Opens in Kotma",
    date: "August 2026",
    category: "Education",
    excerpt: "Our newest digital hub brings computer training to a rural community, opening doors to opportunity for 200+ students.",
    photo: "https://images.pexels.com/photos/6217466/pexels-photo-6217466.jpeg?auto=compress&cs=tinysrgb&w=800",
  },
  {
    title: "Companionship Initiative: 100 Elders Visited This Month",
    date: "July 2026",
    category: "Elderly Care",
    excerpt: "Our volunteers made 300 companionship visits this month, bringing joy and connection to senior citizens.",
    photo: "https://images.pexels.com/photos/11905784/pexels-photo-11905784.jpeg?auto=compress&cs=tinysrgb&w=800",
  },
  {
    title: "Community Development: New Water Facility Completed",
    date: "June 2026",
    category: "Community",
    excerpt: "A new clean water facility now serves 1,500 families, thanks to our donors and partners.",
    photo: "https://images.pexels.com/photos/7519650/pexels-photo-7519650.jpeg?auto=compress&cs=tinysrgb&w=800",
  },
];
---

<BaseLayout title="News & Stories" description={`Latest updates and stories from ${SITE_INFO.name}`}>
  <!-- Page Hero -->
  <PageHero
    kicker="News & Stories"
    title="From the field, to you."
    description="Updates from our programs, stories from the field, and announcements."
  />

  <!-- Article Grid -->
  <section class="section bg-paper">
    <div class="shell">
      <div class="grid md:grid-cols-3 gap-7">
        {posts.map((post) => (
          <article class="group card border border-line flex flex-col justify-between overflow-hidden">
            <div>
              <div class="overflow-hidden aspect-[16/10]">
                <img
                  src={post.photo}
                  alt={post.title}
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                />
              </div>
              <div class="p-7">
                <span class="text-[0.7rem] font-bold tracking-[0.15em] uppercase text-saffron mb-3 block">{post.category}</span>
                <h2 class="font-display text-xl mb-2 leading-snug">{post.title}</h2>
                <p class="text-ink-soft text-sm leading-relaxed">{post.excerpt}</p>
              </div>
            </div>
            <div class="px-7 py-4 border-t border-line flex items-center justify-between">
              <span class="text-ink-faint text-xs">{post.date}</span>
              <a href="#" class="inline-flex items-center gap-2 text-pine font-semibold text-sm hover:gap-3 transition-all">
                Read <span aria-hidden>→</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Newsletter Signup -->
  <section class="section bg-pine-deep text-center text-paper">
    <div class="shell max-w-xl">
      <h2 class="text-3xl md:text-4xl mb-4 font-display">Stay Updated</h2>
      <p class="text-paper/75 mb-8">
        Get our latest stories, program updates, and impact reports in your inbox.
      </p>
      <form id="newsletter-form" class="flex flex-col sm:flex-row gap-4">
        <input
          type="email"
          placeholder="Your email address"
          class="flex-1 px-5 py-3.5 bg-white/10 border border-paper/20 text-paper placeholder:text-paper/50 focus:outline-none focus:border-saffron"
          required
        />
        <button type="submit" class="btn btn-primary !py-3.5">Subscribe</button>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('newsletter-form') as HTMLFormElement;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    alert('Thank you for subscribing!');
    form.reset();
  });
</script>