<BaseLayout title="Media & Photo Gallery — Sarvagun Gyannodaya Trust" description="Explore media reports, press releases, events, and complete field photo gallery.">
  <PageHero
    kicker="Media Center"
    title="Media, Publications & Field Gallery"
    description="Explore our complete photo archive from field operations across India."
  />

  <section class="section bg-slate-50">
    <div class="shell max-w-6xl mx-auto space-y-16">
      
      <!-- Complete Field Photo Gallery -->
      <div>
        <div class="flex items-center justify-between mb-8">
          <div>
            <span class="kicker block mb-1">Authentic Action</span>
            <h2 class="text-2xl font-display font-bold text-slate-900">Ground Field Photo Gallery ({ALL_FIELD_PHOTOS.length} Photos)</h2>
          </div>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
          {ALL_FIELD_PHOTOS.map((photo) => (
            <div class="group relative overflow-hidden border border-slate-200 bg-white aspect-square shadow-xs">
              <img
                src={photo.src}
                alt={photo.title}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-linear-to-t from-black/85 via-black/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity p-2.5 flex flex-col justify-end">
                <span class="text-[10px] font-bold tracking-wider text-saffron uppercase mb-0.5">{photo.tag}</span>
                <span class="text-xs font-semibold text-white leading-tight">{photo.title}</span>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Media Reports Block -->
      <div>
        <div class="flex items-center justify-between mb-8">
          <h2 class="text-2xl font-display font-bold text-slate-900">Media & Field Reports</h2>
          <a href="/media/reports" class="link-arrow">View All Reports</a>
        </div>
        <div class="grid md:grid-cols-2 gap-8">
          {MEDIA_REPORTS.map((item) => (
            <div class="vibrant-card p-6">
              <span class="text-xs font-bold text-saffron uppercase tracking-wider mb-2 block">{item.date}</span>
              <h3 class="font-display text-lg font-bold text-slate-900 mb-2">{item.title}</h3>
              <p class="text-slate-600 text-sm mb-4">{item.summary}</p>
              <a href="/media/reports" class="text-xs font-bold text-slate-800 uppercase tracking-wider hover:text-saffron-deep">Read Report &rarr;</a>
            </div>
          ))}
        </div>
      </div>

      <!-- Press Releases Block -->
      <div>
        <div class="flex items-center justify-between mb-8">
          <h2 class="text-2xl font-display font-bold text-slate-900">Press Releases</h2>
          <a href="/media/press-releases" class="link-arrow">View All Press Releases</a>
        </div>
        <div class="grid md:grid-cols-2 gap-8">
          {PRESS_RELEASES.map((item) => (
            <div class="vibrant-card p-6 border-l-4 border-l-rose-500">
              <span class="text-xs font-bold text-rose-600 uppercase tracking-wider mb-2 block">{item.date}</span>
              <h3 class="font-display text-lg font-bold text-slate-900 mb-2">{item.title}</h3>
              <p class="text-slate-600 text-sm mb-4">{item.summary}</p>
              <a href="/media/press-releases" class="text-xs font-bold text-slate-800 uppercase tracking-wider hover:text-saffron-deep">Read Press Release &rarr;</a>
            </div>
          ))}
        </div>
      </div>

      <!-- Events Block -->
      <div>
        <div class="flex items-center justify-between mb-8">
          <h2 class="text-2xl font-display font-bold text-slate-900">Upcoming Events & Campaigns</h2>
          <a href="/media/events" class="link-arrow">View All Events</a>
        </div>
        <div class="grid md:grid-cols-2 gap-8">
          {EVENTS.map((item) => (
            <div class="vibrant-card p-6 border-l-4 border-l-emerald-600">
              <span class="text-xs font-bold text-emerald-600 uppercase tracking-wider mb-2 block">{item.date}</span>
              <h3 class="font-display text-lg font-bold text-slate-900 mb-2">{item.title}</h3>
              <p class="text-slate-600 text-sm mb-4">{item.summary}</p>
              <a href="/media/events" class="text-xs font-bold text-slate-800 uppercase tracking-wider hover:text-saffron-deep">Event Details &rarr;</a>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>
</BaseLayout>
