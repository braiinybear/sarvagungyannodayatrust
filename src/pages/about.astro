---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import QuoteBlock from '../components/QuoteBlock.astro';
import { SITE_INFO } from '../data/siteData';
import { VALUES, LEADERSHIP, FOUNDER_ACHIEVEMENTS } from '../data/teamData';
---

<BaseLayout title="About Us" description={`Learn about ${SITE_INFO.name}, our mission, and our founder ${SITE_INFO.founder.name}`}>
  <!-- Page Hero -->
  <PageHero
    kicker="About Us"
    title="A vision for lasting change"
    description={`Discover our story, our mission, and the people behind ${SITE_INFO.name}.`}
  />

  <!-- Our Story Section -->
  <section class="section bg-paper">
    <div class="shell grid lg:grid-cols-2 gap-14 items-center">
      <div>
        <p class="kicker mb-4">Our Story</p>
        <h2 class="text-3xl md:text-5xl text-ink mb-6 font-display">Born of a simple belief</h2>
        <p class="text-ink-soft mb-4 leading-relaxed">
          {SITE_INFO.name} was founded with a simple belief: every person deserves
          access to education, dignity in old age, and the opportunity to thrive.
        </p>
        <p class="text-ink-soft mb-4 leading-relaxed">
          What started as a small initiative has grown into a movement impacting thousands
          of lives across India. We work at the intersection of education, elderly care,
          and community development to create sustainable change.
        </p>
        <p class="text-ink-soft leading-relaxed">
          Our approach is rooted in compassion, transparency, and a deep commitment
          to the communities we serve.
        </p>
      </div>
      <div class="img-frame aspect-4/3 overflow-hidden">
        <img
          src="https://images.pexels.com/photos/4848235/pexels-photo-4848235.jpeg?auto=compress&cs=tinysrgb&w=1200"
          alt="Community coming together"
          loading="lazy"
          class="w-full h-full object-cover"
        />
      </div>
    </div>
  </section>

  <!-- In the Field Media Section -->
  <section class="section bg-mist">
    <div class="shell grid lg:grid-cols-2 gap-14 items-center">
      <video
        class="w-full aspect-video object-cover order-2 lg:order-1"
        src="https://videos.pexels.com/video-files/6646649/6646649-hd_1920_1080_30fps.mp4"
        poster="https://images.pexels.com/videos/6646649/africa-causes-change-charity-6646649.jpeg?auto=compress&cs=tinysrgb&w=1200"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
      ></video>
      <div class="order-1 lg:order-2">
        <p class="kicker mb-5">In the Field</p>
        <h2 class="text-[2.2rem] md:text-[3rem] mb-6 font-display">Service in action</h2>
        <p class="text-ink-soft text-lg mb-8 leading-relaxed">
          Volunteers and supporters delivering aid and care — the everyday work
          that turns our mission into a movement.
        </p>
        <a href="/our-work" class="link-arrow">Explore Our Work</a>
      </div>
    </div>
  </section>

  <!-- Founder Section -->
  <section class="section bg-mist border-t border-line/60">
    <div class="shell grid lg:grid-cols-2 gap-14 items-center">
      <div class="order-2 lg:order-1">
        <QuoteBlock
          quote={SITE_INFO.founder.quoteExtended}
          author={SITE_INFO.founder.name}
          role={`${SITE_INFO.founder.role}, ${SITE_INFO.name}`}
          variant="card"
        />
      </div>
      <div class="order-1 lg:order-2">
        <p class="kicker mb-4">Our Founder</p>
        <h2 class="text-3xl md:text-5xl text-ink mb-6 font-display">{SITE_INFO.founder.name}</h2>
        <p class="text-ink-soft mb-6 leading-relaxed">
          {SITE_INFO.founder.name} established {SITE_INFO.name} with a vision to bridge
          the gap between opportunity and access for underserved communities.
        </p>
        <p class="text-ink-soft mb-4 font-semibold">Under his leadership, the trust has:</p>
        <ul class="space-y-3 mb-6">
          {FOUNDER_ACHIEVEMENTS.map((item) => (
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-saffron mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-ink-soft">{item}</span>
            </li>
          ))}
        </ul>
        <p class="text-ink-faint text-sm leading-relaxed">
          As Author/Settlor, Mr. Rawat retains overriding authority to preserve the
          founding vision, ensuring every decision aligns with the mission of compassion,
          education, and dignity for all.
        </p>
      </div>
    </div>
  </section>

  <!-- Mission & Vision Grid -->
  <section class="section bg-paper">
    <div class="shell grid md:grid-cols-2 gap-7">
      <div class="card p-9">
        <div class="w-14 h-14 bg-pine/10 flex items-center justify-center mb-6 text-pine">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="9" />
            <circle cx="12" cy="12" r="5" />
            <circle cx="12" cy="12" r="1.5" fill="currentColor" />
          </svg>
        </div>
        <h3 class="font-display text-2xl mb-4">Our Mission</h3>
        <p class="text-ink-soft leading-relaxed">
          To empower underprivileged communities through education, elderly care,
          and sustainable development, creating lasting change that uplifts
          individuals and strengthens society.
        </p>
      </div>
      <div class="card p-10">
        <div class="w-12 h-12 bg-saffron/15 flex items-center justify-center mb-6 text-saffron">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
            <path stroke-linecap="round" d="M2 12s3.5-6.5 10-6.5S22 12 22 12s-3.5 6.5-10 6.5S2 12 2 12z" />
            <circle cx="12" cy="12" r="2.5" />
          </svg>
        </div>
        <h3 class="font-display text-2xl mb-4">Our Vision</h3>
        <p class="text-ink-soft leading-relaxed">
          A society where every individual has access to quality education,
          dignified elderly care, and equal opportunities to thrive — regardless
          of their background or circumstances.
        </p>
      </div>
    </div>
  </section>

  <!-- Our Values Grid -->
  <section class="section bg-mist">
    <div class="shell">
      <h2 class="text-3xl md:text-4xl text-ink mb-12 text-center font-display">Our Values</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        {VALUES.map((v) => (
          <div class="text-center">
            <div class="w-20 h-20 bg-pine/10 flex items-center justify-center mx-auto mb-5 text-pine">
              <svg class="w-9 h-9" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d={v.icon} />
              </svg>
            </div>
            <h3 class="font-display font-semibold mb-2">{v.name}</h3>
            <p class="text-ink-faint text-sm">{v.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Leadership Team -->
  <section class="section bg-paper">
    <div class="shell">
      <h2 class="text-3xl md:text-4xl text-ink mb-12 text-center font-display">Our Leadership</h2>
      <div class="grid md:grid-cols-3 gap-7">
        {LEADERSHIP.map((member) => (
          <div class="card p-8 text-center">
            <div class={`w-20 h-20 ${member.isFounder ? 'bg-pine text-paper' : 'bg-mist text-ink-faint'} mx-auto mb-5 flex items-center justify-center font-display text-2xl`}>
              {member.initials}
            </div>
            <h3 class="font-display text-xl mb-1">{member.name}</h3>
            <p class="text-saffron text-sm font-semibold mb-3">{member.role}</p>
            <p class="text-ink-soft text-sm leading-relaxed">{member.bio}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Governance & Legal Details -->
  <section class="section bg-mist">
    <div class="shell max-w-3xl mx-auto">
      <h2 class="text-3xl md:text-4xl text-ink mb-12 text-center font-display">Governance &amp; Registration</h2>
      <div class="card p-8 md:p-10">
        <div class="grid md:grid-cols-2 gap-10">
          <div>
            <h3 class="font-display text-lg mb-4">Legal Information</h3>
            <ul class="space-y-2.5 text-ink-soft text-sm">
              <li class="flex gap-2"><span class="text-saffron">•</span> {SITE_INFO.legal.act}</li>
              <li class="flex gap-2"><span class="text-saffron">•</span> {SITE_INFO.legal.regNo}</li>
              <li class="flex gap-2"><span class="text-saffron">•</span> PAN: [XXXXXXXXXX]</li>
              <li class="flex gap-2"><span class="text-saffron">•</span> {SITE_INFO.legal.taxExemption}</li>
            </ul>
          </div>
          <div>
            <h3 class="font-display text-lg mb-4">Annual Reports</h3>
            <ul class="space-y-2.5">
              {["Annual Report 2024-25", "Annual Report 2023-24", "Audited Accounts 2024-25"].map((r) => (
                <li>
                  <a href="#" class="text-pine hover:underline flex items-center gap-2 text-sm">
                    <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                      <path stroke-linecap="round" d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zM14 2v6h6" />
                    </svg>
                    {r} [Download]
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
        <div class="mt-8 pt-6 border-t border-line">
          <p class="text-ink-faint text-sm">
            Trust Deed: Available for inspection upon request. Contact us for more information.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>