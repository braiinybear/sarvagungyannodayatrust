---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { SITE_INFO } from '../../data/siteData';

const MILESTONES = [
  {
    year: "2018",
    title: "The Seed of Inspiration",
    desc: "Inspired by Swami Vivekananda's teachings, Mr. Rahul Rawat launched evening tutorial classes for 25 underprivileged children."
  },
  {
    year: "2020",
    title: "Formal Trust Registration",
    desc: "Sarvagun Gyannodaya Trust was officially registered under the Indian Trust Act, expanding to elderly healthcare and ration support during crises."
  },
  {
    year: "2022",
    title: "Launch of 7 Focus Pillars",
    desc: "Expanded into Sports Academies, Tree Plantation, Nation Building activities, and Cultural Preservation across 15+ communities."
  },
  {
    year: "2024",
    title: "80G Tax Exemption & Digital Hubs",
    desc: "Achieved 80G/12A registration. Set up computer-equipped Gyannodaya digital learning centers serving over 10,000 students."
  },
  {
    year: "2026",
    title: "50,000+ Lives Impacted",
    desc: "Today, operating across 30+ villages and urban hubs with full financial transparency and youth volunteer networks."
  }
];
---

<BaseLayout title="History & Journey" description={`The history and journey of ${SITE_INFO.name}`}>
  <PageHero
    kicker="About Us · History"
    title="Our History & Journey"
    description="A timeline of grassroots dedication, growth, and lives transformed."
  />

  <section class="section bg-white">
    <div class="shell max-w-4xl mx-auto">
      <!-- Vertical Timeline -->
      <div class="relative border-l-2 border-saffron/40 pl-8 ml-4 space-y-12">
        {MILESTONES.map((m) => (
          <div class="relative group">
            <!-- Timeline Dot -->
            <div class="absolute left-[-41px] top-1.5 w-5 h-5 rounded-full bg-saffron border-4 border-white shadow-md group-hover:scale-125 transition-transform"></div>
            
            <div class="vibrant-card p-6 md:p-8">
              <span class="inline-block px-3 py-1 rounded-md bg-saffron-light text-saffron-deep font-bold font-display text-sm mb-3">
                {m.year}
              </span>
              <h3 class="text-xl font-display font-bold text-slate-900 mb-2">{m.title}</h3>
              <p class="text-slate-600 text-sm leading-relaxed">{m.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
