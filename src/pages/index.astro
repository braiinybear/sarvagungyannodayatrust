---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProgramCard from '../components/ProgramCard.astro';
import PhilosophyBlock from '../components/PhilosophyBlock.astro';
import { SITE_INFO } from '../data/siteData';
import { PROGRAMS } from '../data/programsData';
---

<BaseLayout title="Sarvagun Gyannodaya Trust — Education, Sports, Culture & Social Service">
  <!-- Hero — Full-bleed image/video with clean text overlay -->
  <section class="relative min-h-[85vh] flex items-end overflow-hidden bg-navy-deep">
    <video
      class="absolute inset-0 w-full h-full object-cover opacity-40"
      src="https://videos.pexels.com/video-files/16868495/16868495-hd_1920_1080_25fps.mp4"
      poster="https://images.pexels.com/videos/16868495/books-celebrations-childhood-in-india-children-of-india-16868495.jpeg?auto=compress&cs=tinysrgb&w=1600"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
    ></video>
    <div class="absolute inset-0 bg-linear-to-t from-black/80 via-black/40 to-transparent"></div>

    <div class="relative shell pb-20 pt-40 z-10">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 mb-4" data-animate="fade-in">
          <span class="text-[0.7rem] font-bold uppercase tracking-[0.2em] text-amber-400 bg-amber-950/70 px-3 py-1 border border-amber-500/30">
            Registered Public Charitable Trust • 80G Tax Exempt
          </span>
        </div>
        <h1 class="text-white text-4xl sm:text-5xl md:text-6xl font-display font-semibold leading-[1.15] mb-6" data-animate="hero-text">
          Education, Dignity &amp; Service — For Every Life.
        </h1>
        <p class="text-white/80 text-lg md:text-xl leading-relaxed mb-8 max-w-2xl font-normal" data-animate="fade-up" data-delay="0.5">
          Rooted in Swami Vivekananda's philosophy: <em class="text-amber-200">"Service to man is service to God."</em> Empowering youth, elderly, sports talent, and rural communities across India.
        </p>
        <div class="flex flex-wrap items-center gap-4" data-animate="fade-up" data-delay="0.7">
          <a href="/our-work" class="btn btn-primary text-sm font-semibold tracking-wide py-3.5 px-7">
            Explore Our Work
          </a>
          <a href="/about" class="btn btn-outline text-sm font-semibold tracking-wide py-3.5 px-7">
            About the Trust
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Latest Section — Tata Trusts "Latest" horizontal cards with category badges -->
  <section class="section bg-white">
    <div class="shell">
      <div class="flex items-end justify-between mb-10" data-animate="fade-up">
        <div>
          <span class="kicker block mb-2">Latest</span>
          <h2 class="text-2xl md:text-3xl font-display font-semibold text-ink">
            News & Updates
          </h2>
        </div>
        <a href="/media/reports" class="link-more text-sm hidden md:inline-flex">View all</a>
      </div>

      <!-- 3-column editorial cards (Tata Trusts "Latest" section pattern) -->
      <div class="grid md:grid-cols-3 gap-6" data-animate="stagger">
        <article class="card group">
          <div class="relative overflow-hidden">
            <img
              src="/images/education/62d11f3a-0d11-4f51-8e94-093d8ea4fcb3.jpg"
              alt="Education initiative"
              class="w-full aspect-4/3 object-cover transition-transform duration-500 group-hover:scale-[1.03]"
              loading="lazy"
            />
            <span class="badge badge-education absolute top-3 right-3">Education</span>
          </div>
          <div class="p-5">
            <h3 class="font-display text-lg font-semibold text-ink mb-2 leading-snug">
              <a href="/our-work/education" class="hover:text-saffron transition-colors">
                Opening New Learning Centers in Rural Uttarakhand
              </a>
            </h3>
            <p class="text-ink-faint text-sm leading-relaxed mb-4 line-clamp-3">
              Our latest Gyannodaya centers are bringing quality education to children in remote hill villages, combining modern pedagogy with Swami Vivekananda's vision of character-building.
            </p>
            <a href="/our-work/education" class="link-more text-sm">Read more</a>
          </div>
        </article>

        <article class="card group">
          <div class="relative overflow-hidden">
            <img
              src="/images/sports/275cd986-31c3-46ba-81a1-947f509f28c5.jpg"
              alt="Sports initiative"
              class="w-full aspect-4/3 object-cover transition-transform duration-500 group-hover:scale-[1.03]"
              loading="lazy"
            />
            <span class="badge badge-sports absolute top-3 right-3">Sports</span>
          </div>
          <div class="p-5">
            <h3 class="font-display text-lg font-semibold text-ink mb-2 leading-snug">
              <a href="/our-work/sports" class="hover:text-saffron transition-colors">
                Young Athletes Shine at State-Level Championships
              </a>
            </h3>
            <p class="text-ink-faint text-sm leading-relaxed mb-4 line-clamp-3">
              Twelve athletes from our training camps represented their districts in athletics, kabaddi, and wrestling, continuing the tradition of physical excellence and discipline.
            </p>
            <a href="/our-work/sports" class="link-more text-sm">Read more</a>
          </div>
        </article>

        <article class="card group">
          <div class="relative overflow-hidden">
            <img
              src="/images/nation-building/cba21d87-8102-4556-9239-f1b6a9f25ef3.jpg"
              alt="Cultural event"
              class="w-full aspect-4/3 object-cover transition-transform duration-500 group-hover:scale-[1.03]"
              loading="lazy"
            />
            <span class="badge badge-culture absolute top-3 right-3">Culture &amp; Art</span>
          </div>
          <div class="p-5">
            <h3 class="font-display text-lg font-semibold text-ink mb-2 leading-snug">
              <a href="/our-work/culture-art" class="hover:text-saffron transition-colors">
                Preserving Folk Arts Through Community Workshops
              </a>
            </h3>
            <p class="text-ink-faint text-sm leading-relaxed mb-4 line-clamp-3">
              Our cultural preservation program is documenting and reviving traditional art forms, connecting younger generations with their heritage through hands-on workshops.
            </p>
            <a href="/our-work/culture-art" class="link-more text-sm">Read more</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Impact Stories — Asymmetric grid (Tata Trusts "Impact Stories" section) -->
  <section class="section bg-navy-deep text-white">
    <div class="shell">
      <div class="flex items-end justify-between mb-10" data-animate="fade-up">
        <div>
          <span class="kicker block mb-2">Impact Stories</span>
          <h2 class="text-2xl md:text-3xl font-display font-semibold text-white">
            Stories of Change
          </h2>
        </div>
        <a href="/impact" class="text-sm font-semibold text-white/60 hover:text-white border-b border-white/40 pb-0.5 transition-colors hidden md:inline">
          View all stories
        </a>
      </div>

      <!-- Asymmetric layout like Tata Trusts Impact Stories -->
      <div class="grid md:grid-cols-3 gap-5" data-animate="stagger">
        <!-- Large featured story -->
        <div class="md:col-span-2 relative group overflow-hidden">
          <img
            src="/images/education/8640a895-9dee-44f2-be2a-614351170c6e.jpg"
            alt="Rural education impact"
            class="w-full h-full min-h-[380px] object-cover transition-transform duration-500 group-hover:scale-[1.02]"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-linear-to-t from-black/80 via-black/20 to-transparent"></div>
          <span class="badge badge-education absolute top-4 right-4">Education</span>
          <div class="absolute bottom-0 left-0 right-0 p-6">
            <h3 class="font-display text-xl md:text-2xl font-semibold text-white mb-2 leading-snug">
              Seeds of Knowledge: How One Village Transformed Its Future
            </h3>
            <p class="text-white/70 text-sm leading-relaxed mb-3 max-w-lg">
              In a small village in Madhya Pradesh, a single learning center sparked a movement. Today, 300 children attend school daily.
            </p>
            <a href="/impact" class="text-sm font-semibold text-white border-b border-white/50 pb-0.5 hover:border-white transition-colors">
              Read more
            </a>
          </div>
        </div>

        <!-- Side story -->
        <div class="relative group overflow-hidden">
          <img
            src="/images/sports/c7fc56bb-f819-407a-9352-3c92c5eec0e8.jpg"
            alt="Sports impact"
            class="w-full h-full min-h-[380px] object-cover transition-transform duration-500 group-hover:scale-[1.02]"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-linear-to-t from-black/80 via-black/20 to-transparent"></div>
          <span class="badge badge-sports absolute top-4 right-4">Sports</span>
          <div class="absolute bottom-0 left-0 right-0 p-5">
            <h3 class="font-display text-lg font-semibold text-white mb-2 leading-snug">
              From Village Ground to National Stage
            </h3>
            <p class="text-white/70 text-sm leading-relaxed mb-3">
              Young athletes from our rural sports program are now competing at the national level.
            </p>
            <a href="/impact" class="text-sm font-semibold text-white border-b border-white/50 pb-0.5 hover:border-white transition-colors">
              Read more
            </a>
          </div>
        </div>
      </div>

      <!-- Bottom row — 3 smaller stories -->
      <div class="grid md:grid-cols-3 gap-5 mt-5" data-animate="stagger">
        <div class="relative group overflow-hidden">
          <img
            src="/images/nation-building/cba21d87-8102-4556-9239-f1b6a9f25ef3.jpg"
            alt="Cultural heritage"
            class="w-full aspect-4/3 object-cover transition-transform duration-500 group-hover:scale-[1.02]"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-linear-to-t from-black/70 to-transparent"></div>
          <span class="badge badge-culture absolute top-3 right-3">Culture</span>
          <div class="absolute bottom-0 left-0 right-0 p-4">
            <h3 class="font-display text-base font-semibold text-white leading-snug">
              Reviving Traditional Arts in Rural Communities
            </h3>
          </div>
        </div>

        <div class="relative group overflow-hidden">
          <img
            src="/images/environment/4c074d9e-1f52-4df5-98ee-74ed6083020f.jpg"
            alt="Environment initiative"
            class="w-full aspect-4/3 object-cover transition-transform duration-500 group-hover:scale-[1.02]"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-linear-to-t from-black/70 to-transparent"></div>
          <span class="badge badge-environment absolute top-3 right-3">Environment</span>
          <div class="absolute bottom-0 left-0 right-0 p-4">
            <h3 class="font-display text-base font-semibold text-white leading-snug">
              Clean Water, Clean Future: Village Sanitation Drive
            </h3>
          </div>
        </div>

        <div class="relative group overflow-hidden">
          <img
            src="/images/social-work/241dc954-3df6-4d7e-a65e-20eccbb2d488.jpg"
            alt="Social initiative"
            class="w-full aspect-4/3 object-cover transition-transform duration-500 group-hover:scale-[1.02]"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-linear-to-t from-black/70 to-transparent"></div>
          <span class="badge badge-social absolute top-3 right-3">Social</span>
          <div class="absolute bottom-0 left-0 right-0 p-4">
            <h3 class="font-display text-base font-semibold text-white leading-snug">
              Empowering Women Through Self-Help Groups
            </h3>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Areas of Work — Seven Pillars Grid -->
  <section class="section bg-white">
    <div class="shell">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-10" data-animate="fade-up">
        <div>
          <span class="kicker block mb-2">Our Work</span>
          <h2 class="text-2xl md:text-3xl font-display font-semibold text-ink">
            Seven Pillars of Impact
          </h2>
        </div>
        <p class="text-ink-faint text-sm max-w-md">
          Structured programs across Education, Social Care, Sports, Environment, Nation Building, Culture, and Spirituality.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6" data-animate="stagger" data-stagger-delay="0.1">
        {PROGRAMS.map((program) => (
          <ProgramCard program={program} />
        ))}
      </div>
    </div>
  </section>

  <!-- Swami Vivekananda Philosophy -->
  <PhilosophyBlock />

  <!-- Field Video & Impact Section -->
  <section class="section bg-white border-t border-line">
    <div class="shell grid lg:grid-cols-2 gap-12 items-center">
      <div data-animate="slide-right">
        <span class="kicker block mb-3">In the Field</span>
        <h2 class="text-2xl md:text-3xl font-display font-semibold text-ink mb-5">
          See the Change Unfold
        </h2>
        <p class="text-ink-faint text-base leading-relaxed mb-6">
          Moments from our rural learning centers, athletic training camps, and community healthcare drives. Every act of giving turns into lasting transformation.
        </p>
        <a href="/impact" class="btn btn-primary">
          Read Impact Stories
        </a>
      </div>
      <div class="overflow-hidden border border-line aspect-video" data-animate="slide-left">
        <video
          class="w-full h-full object-cover"
          src="https://videos.pexels.com/video-files/12483187/12483187-hd_1920_1080_25fps.mp4"
          poster="https://images.pexels.com/videos/12483187/pexels-photo-12483187.jpeg?auto=compress&cs=tinysrgb&w=1200"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
        ></video>
      </div>
    </div>
  </section>

  <!-- Ground Action Gallery — High visual impact using real field photos -->
  <section class="section bg-mist border-t border-b border-line">
    <div class="shell">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-10 gap-4" data-animate="fade-up">
        <div>
          <span class="kicker block mb-2">Ground Action</span>
          <h2 class="text-2xl md:text-3xl font-display font-semibold text-ink">
            Glimpses of Our Field Operations
          </h2>
        </div>
        <a href="/media" class="link-more text-sm hidden md:inline-flex">Explore Full Photo Gallery</a>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4" data-animate="stagger" data-stagger-delay="0.08">
        <div class="group relative overflow-hidden aspect-square border border-line bg-white">
          <img
            src="/images/nation-building/2f5a282e-db2a-485a-b5a0-a61f978d5d9b.jpg"
            alt="Youth Movement"
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-linear-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity p-3 flex items-end">
            <span class="text-xs font-semibold text-white">Youth Rally &amp; Unity</span>
          </div>
        </div>

        <div class="group relative overflow-hidden aspect-square border border-line bg-white">
          <img
            src="/images/sports/61b6dcec-edfd-4ef7-8ed0-dbef3a3b8b92.jpg"
            alt="Athletic Training"
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-linear-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity p-3 flex items-end">
            <span class="text-xs font-semibold text-white">Sports Excellence</span>
          </div>
        </div>

        <div class="group relative overflow-hidden aspect-square border border-line bg-white">
          <img
            src="/images/education/5ccd5329-8fd1-4209-9bd4-2d16a9999ab5.jpg"
            alt="Classroom Session"
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-linear-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity p-3 flex items-end">
            <span class="text-xs font-semibold text-white">Digital Classroom</span>
          </div>
        </div>

        <div class="group relative overflow-hidden aspect-square border border-line bg-white">
          <img
            src="/images/social-work/dfb2f186-8278-4d63-b63c-b20e47b7e567.jpg"
            alt="Community Relief"
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-linear-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity p-3 flex items-end">
            <span class="text-xs font-semibold text-white">Community Care</span>
          </div>
        </div>

        <div class="group relative overflow-hidden aspect-square border border-line bg-white">
          <img
            src="/images/nation-building/bf3fa072-02d1-4922-bf52-0261e4a4ca8f.jpg"
            alt="Cultural Heritage"
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-linear-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity p-3 flex items-end">
            <span class="text-xs font-semibold text-white">Heritage &amp; Culture</span>
          </div>
        </div>

        <div class="group relative overflow-hidden aspect-square border border-line bg-white">
          <img
            src="/images/environment/5f7e0efe-a451-4414-aee6-7bd54a2ec712.jpg"
            alt="Cleanliness Drive"
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-linear-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity p-3 flex items-end">
            <span class="text-xs font-semibold text-white">Eco Drive</span>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- Final CTA — Clean, simple -->
  <section class="bg-navy-deep text-white py-20 text-center">
    <div class="shell max-w-2xl mx-auto">
      <h2 class="text-2xl md:text-4xl font-display font-semibold mb-5" data-animate="fade-up">
        A Small Act, A Lifetime of Change.
      </h2>
      <p class="text-white/60 text-base leading-relaxed mb-8" data-animate="fade-up" data-delay="0.15">
        Donate, volunteer, or partner with us. Every contribution directly funds our 7 pillars of work.
      </p>
      <div class="flex flex-wrap justify-center gap-3" data-animate="fade-up" data-delay="0.3">
        <a href="/get-involved/donate" class="btn btn-primary">
          Donate Now
        </a>
        <a href="/contact" class="btn btn-outline">
          Contact Us
        </a>
      </div>
    </div>
  </section>
</BaseLayout>