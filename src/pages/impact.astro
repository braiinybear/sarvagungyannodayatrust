---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

const FEATURED_STORY = {
  id: "featured-1",
  category: "Education",
  categoryBadge: "badge-education",
  title: "Seeds of Knowledge: How One Village Transformed Its Future in Almora",
  location: "Almora, Uttarakhand",
  beneficiary: "Rahul Kumar (Age 14)",
  summary: "Son of a daily-wage laborer, Rahul discovered his passion for computer programming at our Gyannodaya Digital Learning Center. Today, he mentors younger kids and has secured a full merit scholarship.",
  fullStory: "Growing up in a remote hill village in Almora, Rahul had never touched a computer. His parents worked long hours in stone quarries. In 2023, Sarvagun Gyannodaya Trust established its digital learning lab in the village school. Within six months, Rahul learned basic Python and web design. His project on solar water heating won 1st prize at the District Science Exhibition. Today, Rahul dreams of becoming a software engineer and expanding digital access across rural India.",
  quote: "Gyannodaya gave me a window to the world. Before this center, I thought computers were only for city kids.",
  image: "/images/education/ea70810c-ddaa-42d8-80d7-ff1129aa1246.jpg",
  impactMetric: "Full Merit Scholarship Awardee"
};

const STORIES = [
  {
    id: "story-1",
    category: "Education",
    categoryBadge: "badge-education",
    title: "From Clay Lamps to Coding: Rahul's Journey in Gyannodaya",
    location: "Almora, Uttarakhand",
    beneficiary: "Rahul Kumar (Age 14)",
    summary: "Son of a daily-wage laborer, Rahul discovered his passion for computer programming at our Gyannodaya Digital Learning Center.",
    fullStory: "Rahul’s village lacked consistent electricity and internet. Our solar-powered Gyannodaya computer center provided him uninterrupted access to learning modules, coding kits, and English literacy programs. His dedication led to a regional scholarship award.",
    quote: "Learning here showed me that my background doesn't limit my dreams.",
    image: "/images/education/d4498011-1a6c-425d-b04a-33452c784635.jpg",
    impactMetric: "Scholarship & Laptop Awardee"
  },
  {
    id: "story-2",
    category: "Social Services",
    categoryBadge: "badge-social",
    title: "Restoring Dignity & Care: Amma's Lifeline in Senior Welfare",
    location: "Indore, Madhya Pradesh",
    beneficiary: "Kamla Devi (Age 72)",
    summary: "After losing her family, Kamla Devi found medical care, pension assistance, and a loving community at our senior welfare drive.",
    fullStory: "72-year-old Kamla Devi lived in isolation with untreated cataract and no income. Through our Senior Care initiative, she received free eye surgery, monthly pension enrollment, and daily nutritious meals in a supportive community center.",
    quote: "I found a family when I thought I was all alone.",
    image: "/images/social-work/bea900bc-9728-4e10-b074-cfc009fde77b.jpg",
    impactMetric: "Free Health & Pension Support"
  },
  {
    id: "story-3",
    category: "Sports",
    categoryBadge: "badge-sports",
    title: "Running with Pride: Neha's Athletic Breakthrough",
    location: "Ranchi, Jharkhand",
    beneficiary: "Neha Munda (Age 16)",
    summary: "Trained at our rural sports academy, Neha won gold at the State Junior Athletics Championship in 800m sprint.",
    fullStory: "Neha used to run barefoot across village trails. Recognized by our talent scouts, she was provided professional running shoes, nutrition, and expert coaching. She now targets the National Junior Games.",
    quote: "Sports taught me confidence. When I run, I feel unstoppable.",
    image: "/images/sports/3268f985-9c9a-4a2f-ab5c-fe034df41098.jpg",
    impactMetric: "State Athletics Gold Medalist"
  },
  {
    id: "story-4",
    category: "Environment",
    categoryBadge: "badge-environment",
    title: "A Village Transformed: 5,000 Trees in Devprayag",
    location: "Devprayag, Uttarakhand",
    beneficiary: "Community Initiative",
    summary: "Villagers and youth volunteers planted native fruit trees, securing water retention and village eco-tourism income.",
    fullStory: "Soil erosion was threatening agriculture in Devprayag. Our green drive mobilized 200 local families to plant citrus and walnut saplings, revitalizing local springs and providing long-term income.",
    quote: "Protecting our land today ensures our children have a sustainable tomorrow.",
    image: "/images/environment/466d579b-dce5-4be6-b718-5bbcb6e4cd64.jpg",
    impactMetric: "5,000 Trees Planted"
  },
  {
    id: "story-5",
    category: "Nation Building",
    categoryBadge: "badge-nation",
    title: "Disaster Relief Brigade in Action",
    location: "Flood Relief Camp, UP",
    beneficiary: "Yuva Volunteer Corps",
    summary: "Our 120 trained youth volunteers delivered food, clean water, and emergency medical kits to flood-affected families.",
    fullStory: "During severe seasonal flooding, our Yuva Brigade set up 3 mobile field kitchens and distributed over 5,000 ration kits and water purification tablets to stranded villagers within 48 hours.",
    quote: "Service to the nation in times of crisis is our highest duty.",
    image: "/images/nation-building/577c40cc-4286-4d30-8b78-e908eab8f27c.jpg",
    impactMetric: "2,500 Families Rescued"
  },
  {
    id: "story-6",
    category: "Culture & Art",
    categoryBadge: "badge-culture",
    title: "Reviving Folk Weaving & Artisan Guilds",
    location: "Varanasi, Uttar Pradesh",
    beneficiary: "Artisan Co-operative",
    summary: "Supporting traditional handloom weavers with raw materials, fair trade pricing, and digital marketplace access.",
    fullStory: "Traditional silk weavers were abandoning their craft due to middleman exploitation. Our artisan guild project provided direct market linkage, interest-free micro-grants, and fair compensation.",
    quote: "Our heritage is alive again because young people can now earn a proud living from it.",
    image: "/images/nation-building/cba21d87-8102-4556-9239-f1b6a9f25ef3.jpg",
    impactMetric: "45 Weaver Families Empowered"
  }
];

const CATEGORIES = ["All", "Education", "Social Services", "Sports", "Environment", "Nation Building", "Culture & Art"];

const IMPACT_STATS = [
  { target: 50000, suffix: "+", label: "Lives Impacted Across India", icon: "❤️" },
  { target: 10000, suffix: "+", label: "Students Educated in Gyannodaya", icon: "🎓" },
  { target: 30, suffix: "+", label: "Rural & Urban Villages Served", icon: "🏡" },
  { target: 100, suffix: "%", label: "Audited Financial Transparency", icon: "📜" }
];
---

<BaseLayout title="Impact Stories — SARVAGUN Gyannodaya Trust" description="Read real, verified stories of human transformation across education, sports, elderly care, and social development.">
  <!-- Hero Section -->
  <PageHero
    kicker="Field Transformations"
    title="Voices of Transformation & Hope"
    description="Real, verified stories of human dignity, village development, and youth empowerment across India."
  />

  <!-- Motto Banner -->
  <div class="bg-amber-950 text-amber-100 py-4 px-6 border-b border-amber-900/40 text-center">
    <p class="font-display text-base md:text-lg tracking-wide font-medium">
      अनुभव से बदलाव • गाथा से प्रेरणा • संकल्प से सिद्धि
    </p>
  </div>

  <!-- High-Impact Live Animated Stats Bar -->
  <section class="bg-navy-deep text-white py-12 border-b border-white/10">
    <div class="shell grid grid-cols-2 lg:grid-cols-4 gap-6 text-center" data-animate="stagger">
      {IMPACT_STATS.map((s) => (
        <div class="p-6 bg-white/5 border border-white/10 hover:border-amber-500/40 transition-all duration-300">
          <div class="text-3xl mb-2">{s.icon}</div>
          <div class="font-display text-3xl md:text-5xl font-bold text-amber-400 mb-1 stat-counter" data-target={s.target} data-suffix={s.suffix}>
            0{s.suffix}
          </div>
          <div class="text-white/70 text-xs font-bold uppercase tracking-wider">{s.label}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- Featured Story Banner Spotlight -->
  <section class="py-12 md:py-16 bg-mist border-b border-line">
    <div class="shell max-w-5xl mx-auto">
      <div class="flex items-center justify-between mb-6">
        <span class="text-xs font-bold uppercase tracking-[0.2em] text-saffron-deep block">Spotlight Transformation Story</span>
        <span class="text-xs font-semibold text-stone-500">📍 Almora, Uttarakhand</span>
      </div>

      <div class="card grid lg:grid-cols-12 overflow-hidden border border-line bg-white group hover:border-amber-700/40 transition-all duration-300">
        <div class="lg:col-span-7 relative overflow-hidden min-h-[320px] lg:min-h-[440px]">
          <img
            src={FEATURED_STORY.image}
            alt={FEATURED_STORY.title}
            class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
          />
          <div class="absolute inset-0 bg-linear-to-t from-black/80 via-black/20 to-transparent"></div>
          <span class={`badge ${FEATURED_STORY.categoryBadge} absolute top-4 left-4 shadow-xs`}>
            {FEATURED_STORY.category}
          </span>
          <div class="absolute bottom-4 left-4 right-4 text-white text-xs font-semibold flex items-center justify-between">
            <span>📍 {FEATURED_STORY.location}</span>
            <span class="bg-amber-800 text-white px-3 py-1 font-bold text-[0.7rem] uppercase tracking-wider">{FEATURED_STORY.impactMetric}</span>
          </div>
        </div>

        <div class="lg:col-span-5 p-8 flex flex-col justify-between bg-white space-y-6">
          <div class="space-y-4">
            <span class="text-[0.7rem] font-bold uppercase tracking-[0.15em] text-saffron-deep bg-saffron-light px-2.5 py-1 border border-amber-800/10 inline-block">
              {FEATURED_STORY.beneficiary}
            </span>
            <h2 class="font-display text-2xl md:text-3xl font-semibold text-ink leading-snug">
              {FEATURED_STORY.title}
            </h2>
            <p class="text-ink-soft text-sm leading-relaxed">
              {FEATURED_STORY.summary}
            </p>
            <blockquote class="p-4 bg-amber-50/70 border-l-3 border-amber-800 text-ink-soft text-xs italic">
              &ldquo;{FEATURED_STORY.quote}&rdquo;
            </blockquote>
          </div>

          <div>
            <button
              class="open-modal-btn btn btn-dark w-full text-xs font-semibold uppercase tracking-wider py-3 cursor-pointer"
              data-title={FEATURED_STORY.title}
              data-category={FEATURED_STORY.category}
              data-location={FEATURED_STORY.location}
              data-beneficiary={FEATURED_STORY.beneficiary}
              data-fullstory={FEATURED_STORY.fullStory}
              data-quote={FEATURED_STORY.quote}
              data-metric={FEATURED_STORY.impactMetric}
              data-image={FEATURED_STORY.image}
            >
              Read Full Interactive Story →
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Story Showcase Grid with Filters -->
  <section class="py-12 md:py-16 bg-white">
    <div class="shell max-w-5xl mx-auto space-y-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6" data-animate="fade-up">
        <div>
          <span class="text-xs font-bold uppercase tracking-[0.2em] text-saffron-deep block mb-2">Our Field Impact</span>
          <h2 class="text-2xl md:text-3xl font-display font-semibold text-ink">
            Transformation Stories Gallery
          </h2>
        </div>

        <!-- Category Filter Tabs -->
        <div class="flex flex-wrap items-center gap-2" id="filter-tabs">
          {CATEGORIES.map((cat, idx) => (
            <button
              class={`filter-tab px-3.5 py-1.5 text-xs font-bold uppercase tracking-wider border transition-all cursor-pointer ${
                idx === 0
                  ? 'bg-amber-950 text-white border-amber-950'
                  : 'bg-white text-ink-soft border-line hover:border-amber-800'
              }`}
              data-category={cat}
            >
              {cat}
            </button>
          ))}
        </div>
      </div>

      <!-- Story Cards Grid -->
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6" id="stories-grid" data-animate="stagger">
        {STORIES.map((s) => (
          <article
            class="story-card card flex flex-col justify-between bg-white border border-line hover:border-amber-700/40 transition-all duration-300 group"
            data-category={s.category}
          >
            <div>
              <div class="relative aspect-4/3 overflow-hidden bg-mist">
                <img
                  src={s.image}
                  alt={s.title}
                  class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
                  loading="lazy"
                />
                <span class={`badge ${s.categoryBadge} absolute top-3 right-3 shadow-xs`}>
                  {s.category}
                </span>
              </div>

              <div class="p-6 space-y-3">
                <div class="flex items-center justify-between text-xs text-ink-faint font-medium">
                  <span>📍 {s.location}</span>
                  <span class="text-saffron-deep font-semibold">{s.beneficiary}</span>
                </div>
                <h3 class="font-display text-lg font-semibold text-ink leading-snug group-hover:text-saffron-deep transition-colors">
                  {s.title}
                </h3>
                <p class="text-ink-faint text-xs leading-relaxed line-clamp-3">
                  {s.summary}
                </p>
              </div>
            </div>

            <div class="p-6 pt-0 border-t border-line/80 flex items-center justify-between mt-auto">
              <span class="text-[0.65rem] font-bold uppercase tracking-wider text-amber-900 bg-amber-50 px-2.5 py-1 border border-amber-800/10">
                ✓ {s.impactMetric}
              </span>
              <button
                class="open-modal-btn inline-flex items-center gap-1 text-xs font-bold uppercase tracking-wider text-ink group-hover:text-saffron-deep transition-colors cursor-pointer border-none bg-transparent"
                data-title={s.title}
                data-category={s.category}
                data-location={s.location}
                data-beneficiary={s.beneficiary}
                data-fullstory={s.fullStory}
                data-quote={s.quote}
                data-metric={s.impactMetric}
                data-image={s.image}
              >
                <span>Read</span>
                <svg class="w-3.5 h-3.5 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                </svg>
              </button>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Financial Governance & Audit Section -->
  <section class="py-12 md:py-16 bg-mist border-t border-line">
    <div class="shell max-w-5xl mx-auto space-y-10">
      <div class="grid lg:grid-cols-2 gap-10 items-center">
        <div>
          <span class="text-xs font-bold uppercase tracking-[0.2em] text-saffron-deep block mb-2">Statutory Transparency</span>
          <h2 class="text-2xl md:text-3xl font-display font-semibold text-ink mb-4">
            Where Your Support Goes
          </h2>
          <p class="text-ink-soft text-sm leading-relaxed mb-6">
            At Sarvagun Gyannodaya Trust, we maintain strict statutory audit compliance. 90% of every rupee raised directly funds field programs, educational centers, and beneficiary care.
          </p>

          <div class="space-y-4 bg-white p-6 border border-line">
            <div>
              <div class="flex justify-between text-xs font-bold uppercase tracking-wider mb-1">
                <span>Field Programs &amp; Beneficiary Care</span>
                <span class="text-amber-800">90%</span>
              </div>
              <div class="h-2 bg-stone-100 overflow-hidden border border-stone-200">
                <div class="h-full bg-amber-800" style="width: 90%"></div>
              </div>
            </div>
            <div>
              <div class="flex justify-between text-xs font-bold uppercase tracking-wider mb-1">
                <span>Administration &amp; Operations</span>
                <span class="text-slate-800">7%</span>
              </div>
              <div class="h-2 bg-stone-100 overflow-hidden border border-stone-200">
                <div class="h-full bg-slate-800" style="width: 7%"></div>
              </div>
            </div>
            <div>
              <div class="flex justify-between text-xs font-bold uppercase tracking-wider mb-1">
                <span>Community Awareness</span>
                <span class="text-rose-800">3%</span>
              </div>
              <div class="h-2 bg-stone-100 overflow-hidden border border-stone-200">
                <div class="h-full bg-rose-800" style="width: 3%"></div>
              </div>
            </div>
          </div>
        </div>

        <!-- Downloadable Audit Box -->
        <div class="bg-white border border-line p-8">
          <h3 class="font-display text-xl font-semibold text-ink mb-4">Statutory Audit Documents</h3>
          <ul class="space-y-3 mb-6 text-sm">
            <li class="flex items-center justify-between p-3.5 bg-mist border border-line">
              <span class="font-medium text-ink-soft text-xs">Audited Accounts FY 2024-25</span>
              <a href="/media/reports" class="text-xs font-bold uppercase tracking-wider text-amber-800 hover:underline">Download PDF</a>
            </li>
            <li class="flex items-center justify-between p-3.5 bg-mist border border-line">
              <span class="font-medium text-ink-soft text-xs">80G &amp; 12A Exemption Certificate</span>
              <a href="/media/reports" class="text-xs font-bold uppercase tracking-wider text-amber-800 hover:underline">Download PDF</a>
            </li>
            <li class="flex items-center justify-between p-3.5 bg-mist border border-line">
              <span class="font-medium text-ink-soft text-xs">Annual Activity Report 2025</span>
              <a href="/media/reports" class="text-xs font-bold uppercase tracking-wider text-amber-800 hover:underline">Download PDF</a>
            </li>
          </ul>
          <p class="text-xs text-ink-faint text-center">Donations are 50% tax-exempt under Section 80G of the Income Tax Act.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Story Detail Modal -->
  <dialog id="story-modal" class="p-0 border-none backdrop:bg-black/70 backdrop:backdrop-blur-sm max-w-2xl w-full mx-auto my-auto z-50">
    <div class="bg-white border border-line shadow-2xl overflow-hidden max-h-[90vh] flex flex-col">
      <div class="relative aspect-video overflow-hidden shrink-0 bg-mist">
        <img id="modal-image" src="" alt="" class="w-full h-full object-cover" />
        <button id="close-modal" class="absolute top-4 right-4 w-8 h-8 rounded-full bg-black/70 text-white flex items-center justify-center font-bold hover:bg-black transition-colors cursor-pointer" aria-label="Close modal">✕</button>
        <span id="modal-category" class="badge absolute top-4 left-4 shadow-xs"></span>
      </div>
      <div class="p-6 md:p-8 overflow-y-auto space-y-4">
        <div class="flex items-center justify-between text-xs text-ink-faint font-semibold">
          <span id="modal-location"></span>
          <span id="modal-beneficiary" class="text-saffron-deep font-bold"></span>
        </div>
        <h3 id="modal-title" class="font-display text-2xl font-semibold text-ink leading-snug"></h3>
        <p id="modal-fullstory" class="text-ink-soft text-sm leading-relaxed"></p>
        <blockquote class="p-4 bg-amber-50 border-l-3 border-amber-800 text-ink-soft text-xs italic">
          &ldquo;<span id="modal-quote"></span>&rdquo;
        </blockquote>
        <div class="pt-4 border-t border-line flex items-center justify-between">
          <span id="modal-metric" class="text-[0.65rem] font-bold uppercase tracking-wider text-amber-900 bg-amber-50 px-3 py-1 border border-amber-800/10"></span>
          <a href="/get-involved/donate" class="btn btn-primary text-xs font-semibold py-2.5 px-5">Sponsor This Cause</a>
        </div>
      </div>
    </div>
  </dialog>
</BaseLayout>

<script>
  // 1. Category Filter Logic with Animation
  const tabs = document.querySelectorAll('.filter-tab');
  const cards = document.querySelectorAll<HTMLElement>('.story-card');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const selected = tab.getAttribute('data-category');

      tabs.forEach((t) => {
        t.classList.remove('bg-amber-950', 'text-white', 'border-amber-950');
        t.classList.add('bg-white', 'text-ink-soft', 'border-line');
      });
      tab.classList.add('bg-amber-950', 'text-white', 'border-amber-950');
      tab.classList.remove('bg-white', 'text-ink-soft', 'border-line');

      cards.forEach((card) => {
        const cat = card.getAttribute('data-category');
        if (selected === 'All' || cat === selected) {
          card.style.display = 'flex';
          setTimeout(() => { card.style.opacity = '1'; }, 50);
        } else {
          card.style.opacity = '0';
          setTimeout(() => { card.style.display = 'none'; }, 200);
        }
      });
    });
  });

  // 2. Interactive Story Modal Logic
  const modal = document.getElementById('story-modal') as HTMLDialogElement;
  const closeModalBtn = document.getElementById('close-modal');
  const openModalBtns = document.querySelectorAll('.open-modal-btn');

  openModalBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const title = btn.getAttribute('data-title') || '';
      const category = btn.getAttribute('data-category') || '';
      const location = btn.getAttribute('data-location') || '';
      const beneficiary = btn.getAttribute('data-beneficiary') || '';
      const fullstory = btn.getAttribute('data-fullstory') || '';
      const quote = btn.getAttribute('data-quote') || '';
      const metric = btn.getAttribute('data-metric') || '';
      const image = btn.getAttribute('data-image') || '';

      (document.getElementById('modal-title') as HTMLElement).textContent = title;
      (document.getElementById('modal-category') as HTMLElement).textContent = category;
      (document.getElementById('modal-location') as HTMLElement).textContent = `📍 ${location}`;
      (document.getElementById('modal-beneficiary') as HTMLElement).textContent = beneficiary;
      (document.getElementById('modal-fullstory') as HTMLElement).textContent = fullstory;
      (document.getElementById('modal-quote') as HTMLElement).textContent = quote;
      (document.getElementById('modal-metric') as HTMLElement).textContent = `✓ ${metric}`;
      (document.getElementById('modal-image') as HTMLImageElement).src = image;

      modal?.showModal();
    });
  });

  closeModalBtn?.addEventListener('click', () => {
    modal?.close();
  });

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      modal.close();
    }
  });

  // 3. Live Animated Stats Counter Logic
  const counters = document.querySelectorAll<HTMLElement>('.stat-counter');

  const animateCounters = () => {
    counters.forEach((counter) => {
      const target = Number(counter.getAttribute('data-target'));
      const suffix = counter.getAttribute('data-suffix') || '';
      let count = 0;
      const step = Math.max(1, Math.floor(target / 40));

      const timer = setInterval(() => {
        count += step;
        if (count >= target) {
          count = target;
          clearInterval(timer);
        }
        counter.textContent = `${count.toLocaleString('en-IN')}${suffix}`;
      }, 30);
    });
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        animateCounters();
        observer.disconnect();
      }
    });
  }, { threshold: 0.2 });

  const statsSection = document.querySelector('.stat-counter');
  if (statsSection) {
    observer.observe(statsSection);
  }
</script>