---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import StatCard from '../components/StatCard.astro';
import { SITE_INFO } from '../data/siteData';
import { KEY_STATS } from '../data/statsData';
import { PROGRAMS } from '../data/programsData';
---

<BaseLayout title="Impact" description={`Impact and transparency reports by ${SITE_INFO.name}`}>
  <!-- Page Hero -->
  <PageHero
    kicker="Impact & Transparency"
    title="What we have done, in numbers — and in lives."
    description="Every rupee is tracked, every program is reported, and every promise is kept. Here is our progress so far — and how your support is spent."
    breadcrumbs={[
      { label: "Home", href: "/" },
      { label: "Impact" }
    ]}
  />

  <!-- Key Statistics Grid -->
  <section class="section bg-paper">
    <div class="shell">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
        {KEY_STATS.map((stat) => (
          <StatCard stat={stat} size="lg" />
        ))}
      </div>
    </div>
  </section>

  <!-- Impact by Program -->
  <section class="section bg-mist">
    <div class="shell">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-14">
        <p class="kicker mb-4 md:mb-0">Impact by Program</p>
        <a href="/our-work" class="link-arrow">All Programs</a>
      </div>

      <div class="grid md:grid-cols-3 gap-10">
        {PROGRAMS.map((program) => (
          <article class="card p-6 border border-line flex flex-col justify-between">
            <div>
              <div class="overflow-hidden mb-6">
                <img
                  src={program.image}
                  alt={program.imageAlt}
                  class="w-full aspect-[4/3] object-cover"
                  loading="lazy"
                />
              </div>
              <p class="text-[0.68rem] font-bold tracking-[0.22em] uppercase text-saffron mb-3">{program.title}</p>
              <p class="font-display text-xl mb-3">{program.tagline}</p>
              <p class="text-ink-soft text-sm leading-relaxed mb-6">{program.fullDescription || program.description}</p>
            </div>
            <a href={program.href} class="link-arrow">Learn More</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Financial Transparency -->
  <section class="section bg-paper">
    <div class="shell grid lg:grid-cols-2 gap-16">
      <div>
        <p class="kicker mb-6">Transparency</p>
        <h2 class="text-[2.2rem] md:text-[3rem] mb-6 font-display">Where your donation goes</h2>
        <p class="text-ink-soft text-lg mb-10 leading-relaxed">
          We publish annual accounts, and every rupee is tracked to a program.
          No exceptions, no middlemen eating the difference.
        </p>
        <div class="flex flex-wrap gap-6">
          <a href="#" class="btn btn-dark">Annual Report 2025–26</a>
          <a href="#" class="btn btn-ghost">Audited Accounts</a>
        </div>
      </div>

      <div class="flex flex-col justify-center">
        <div class="mb-7">
          <div class="flex justify-between items-baseline mb-2">
            <span class="font-semibold text-sm">Programs &amp; Beneficiaries</span>
            <span class="font-display text-2xl text-pine">90%</span>
          </div>
          <div class="h-1 bg-mist rounded-full overflow-hidden">
            <div class="h-full bg-pine" style="width: 90%"></div>
          </div>
        </div>
        <div class="mb-7">
          <div class="flex justify-between items-baseline mb-2">
            <span class="font-semibold text-sm">Administration</span>
            <span class="font-display text-2xl text-saffron">7%</span>
          </div>
          <div class="h-1 bg-mist rounded-full overflow-hidden">
            <div class="h-full bg-saffron" style="width: 7%"></div>
          </div>
        </div>
        <div class="mb-7">
          <div class="flex justify-between items-baseline mb-2">
            <span class="font-semibold text-sm">Fundraising</span>
            <span class="font-display text-2xl text-ember">3%</span>
          </div>
          <div class="h-1 bg-mist rounded-full overflow-hidden">
            <div class="h-full bg-ember" style="width: 3%"></div>
          </div>
        </div>

        <div class="border-t border-line pt-8 mt-2">
          <p class="text-sm text-ink-soft leading-relaxed">
            Contributions to {SITE_INFO.name} are eligible for tax
            benefits under <span class="font-semibold text-ink">Section 80G</span> of the
            Income Tax Act. Your receipt is issued within 24 hours of donation.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- In the Field Video -->
  <section class="section bg-mist">
    <div class="shell grid lg:grid-cols-2 gap-14 items-center">
      <div>
        <p class="kicker mb-5">In the Field</p>
        <h2 class="text-[2.2rem] md:text-[3rem] mb-6 font-display">The future in their hands</h2>
        <p class="text-ink-soft text-lg mb-8 leading-relaxed">
          A classroom moment from our digital literacy program — where curiosity
          becomes opportunity.
        </p>
        <a href="/our-work/education" class="link-arrow">Our Education Work</a>
      </div>
      <video
        class="w-full aspect-video object-cover"
        src="https://videos.pexels.com/video-files/8617293/8617293-hd_1920_1080_25fps.mp4"
        poster="https://images.pexels.com/videos/8617293/adult-brainstorming-child-class-8617293.jpeg?auto=compress&cs=tinysrgb&w=1200"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
      ></video>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="bg-pine-deep text-paper">
    <div class="shell section text-center">
      <p class="font-display text-[2.2rem] md:text-[3.4rem] tracking-tight leading-[1.15] max-w-3xl mx-auto">
        Help us reach the next 50,000.
      </p>
      <div class="mt-10 flex flex-wrap justify-center gap-6">
        <a href="/get-involved/donate" class="btn btn-accent">Donate Today</a>
        <a href="/get-involved/volunteer" class="btn btn-light">Become a Volunteer</a>
      </div>
    </div>
  </section>
</BaseLayout>