---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { SITE_INFO } from '../../data/siteData';

const OPTIONS = [
  {
    title: "Donate",
    desc: "Your donation funds education, elderly care, and community programs. Every rupee goes where it matters.",
    href: "/get-involved/donate",
    cta: "Donate Now",
    img: "https://images.pexels.com/photos/6646918/pexels-photo-6646918.jpeg?auto=compress&cs=tinysrgb&w=800",
    alt: "Person donating"
  },
  {
    title: "Volunteer",
    desc: "Give your time and skills — teach, visit elders, organize events, and be part of real change.",
    href: "/get-involved/volunteer",
    cta: "Become a Volunteer",
    img: "https://images.pexels.com/photos/6647015/pexels-photo-6647015.jpeg?auto=compress&cs=tinysrgb&w=800",
    alt: "Volunteers working together"
  },
  {
    title: "Partner With Us",
    desc: "CSR partnerships, program sponsorship, and in-kind support for measurable social impact.",
    href: "/get-involved/partner",
    cta: "Partner With Us",
    img: "https://images.pexels.com/photos/6646926/pexels-photo-6646926.jpeg?auto=compress&cs=tinysrgb&w=800",
    alt: "People collaborating"
  }
];
---

<BaseLayout title="Get Involved" description={`Donate, volunteer, or partner with ${SITE_INFO.name}`}>
  <!-- Page Hero -->
  <PageHero
    kicker="Get Involved"
    title="There are many ways to help."
    description="Donate, volunteer, or bring your organization with us. Choose how you'd like to make a difference."
  />

  <!-- Involvement Grid -->
  <section class="section bg-paper">
    <div class="shell grid md:grid-cols-3 gap-7">
      {OPTIONS.map((item) => (
        <a href={item.href} class="group card border border-line flex flex-col justify-between overflow-hidden hover:shadow-lg transition-shadow">
          <div>
            <div class="overflow-hidden aspect-[16/10]">
              <img
                src={item.img}
                alt={item.alt}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
              />
            </div>
            <div class="p-7">
              <h2 class="font-display text-2xl mb-3">{item.title}</h2>
              <p class="text-ink-soft text-sm leading-relaxed">{item.desc}</p>
            </div>
          </div>
          <div class="p-7 pt-0">
            <span class="inline-flex items-center gap-2 text-pine font-semibold text-sm">
              {item.cta} <span aria-hidden>→</span>
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>