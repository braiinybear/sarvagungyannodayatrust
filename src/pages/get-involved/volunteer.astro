---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { SITE_INFO } from '../../data/siteData';

const VOLUNTEER_ROLES = [
  {
    title: "Teach & Tutor",
    desc: "Run after-school classes, teach computer basics, or mentor students preparing for exams and careers.",
    icon: "M12 3l2.7 5.5 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1L3.2 9.4l6.1-.9L12 3z"
  },
  {
    title: "Visit Our Elders",
    desc: "Companionship visits, helping with errands, or simply being present — the smallest gestures matter most.",
    icon: "M12 21s-7-4.6-9.2-9A5.4 5.4 0 0 1 12 6.3 5.4 5.4 0 0 1 21.2 12C19 16.4 12 21 12 21z"
  },
  {
    title: "Support Health Camps",
    desc: "Help organize free check-up camps — registration desks, logistics, or translating between doctors and patients.",
    icon: "M9 12l2 2 4-4 M12 3l7 3v5c0 5-3.2 8.4-7 10-3.8-1.6-7-5-7-10V6l7-3z"
  },
  {
    title: "Drive a Community Day",
    desc: "Plan cleanliness drives, book banks, and skill workshops alongside the communities we serve.",
    icon: "M3 21V9l6-5 6 5v12 M9 21v-6h6v6"
  }
];
---

<BaseLayout title="Volunteer" description={`Volunteer with ${SITE_INFO.name}`}>
  <!-- Page Hero -->
  <PageHero
    kicker="Get Involved"
    title="Give your time. Change a life."
    description="From teaching a child to code to sitting with an elder who needs company — there is a place for your skills, however small."
    breadcrumbs={[
      { label: "Get Involved", href: "/get-involved" },
      { label: "Volunteer" }
    ]}
  >
    <div class="mt-8 flex flex-wrap gap-4">
      <a href="/contact" class="btn btn-primary">Apply to Volunteer</a>
      <a href="/get-involved/donate" class="btn btn-ghost">Prefer to Donate?</a>
    </div>
  </PageHero>

  <!-- Volunteer Roles -->
  <section class="section bg-paper">
    <div class="shell">
      <div class="mb-14">
        <p class="kicker mb-4">Ways to Volunteer</p>
        <h2 class="text-3xl md:text-5xl text-ink font-display">Where you can help</h2>
      </div>
      <div class="grid md:grid-cols-2 gap-7">
        {VOLUNTEER_ROLES.map((role) => (
          <div class="card p-8 border border-line">
            <div class="w-12 h-12 bg-pine/10 flex items-center justify-center mb-5 text-pine">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d={role.icon} />
              </svg>
            </div>
            <h3 class="font-display text-xl mb-3">{role.title}</h3>
            <p class="text-ink-soft text-sm leading-relaxed">{role.desc}</p>
          </div>
        ))}
      </div>
    </div> 
  </section>

  <!-- Commitment Levels -->
  <section class="section bg-mist">
    <div class="shell grid lg:grid-cols-3 gap-10">
      <div class="border-t border-line pt-8">
        <p class="font-display text-4xl mb-3">A Weekend</p>
        <p class="text-ink-soft text-sm leading-relaxed">
          One-off camps, drives, and events. Perfect if you want to start small.
        </p>
      </div>
      <div class="border-t border-line pt-8">
        <p class="font-display text-4xl mb-3">A Few Hours a Month</p>
        <p class="text-ink-soft text-sm leading-relaxed">
          Regular teaching or companion visits — the backbone of our programs.
        </p>
      </div>
      <div class="border-t border-line pt-8">
        <p class="font-display text-4xl mb-3">An Ongoing Skill</p>
        <p class="text-ink-soft text-sm leading-relaxed">
          Doctors, teachers, designers, and accountants — professionals who share their craft with us.
        </p>
      </div>
    </div>
  </section>

  <!-- Volunteer CTA -->
  <section class="section bg-pine-deep text-center text-paper">
    <div class="shell max-w-2xl">
      <h2 class="text-3xl md:text-4xl mb-4 font-display">Ready to start?</h2>
      <p class="text-paper/75 mb-8 leading-relaxed">
        Tell us your skills and your time — we will find the right place for you.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/contact" class="btn btn-accent">Apply to Volunteer</a>
        <a href={`mailto:${SITE_INFO.contact.email}`} class="btn btn-light">{SITE_INFO.contact.email}</a>
      </div>
    </div>
  </section>
</BaseLayout>