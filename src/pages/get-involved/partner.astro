---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { SITE_INFO } from '../../data/siteData';

const REASONS = [
  {
    title: "CSR Compliance",
    desc: "Registered trust eligible for CSR funding under Indian law.",
    icon: "M9 12l2 2 4-4M12 3l7 3v5c0 5-3.2 8.4-7 10-3.8-1.6-7-5-7-10V6l7-3z"
  },
  {
    title: "Tangible Reports",
    desc: "Detailed impact reports and audited financial documentation for stakeholders.",
    icon: "M4 4h16v16H4zM8 9h8M8 13h8M8 17h5"
  },
  {
    title: "Employee Engagement",
    desc: "Field volunteering opportunities that boost team morale and purpose.",
    icon: "M16 11a3 3 0 0 0 0-6M18 21a4 4 0 0 0-8 0M9 8a3 3 0 0 1-6 0 3 3 0 0 1 6 0z"
  },
  {
    title: "Brand Alignment",
    desc: "Align your brand with genuine education, healthcare, and rural empowerment initiatives.",
    icon: "M12 3l1.8 4.6L18.5 8l-3.5 3 1 4.7-4-2.5-4 2.5 1-4.7L5.5 8l4.7-.4L12 3z"
  }
];

const MODELS = [
  {
    title: "Fund a Program",
    desc: "Support a complete program — from digital literacy centers to elderly care initiatives — with full program ownership and reporting.",
    icon: "M3 21V9l6-5 6 5v12M9 21v-6h6v6"
  },
  {
    title: "Sponsor a Community",
    desc: "Adopt a village or community and fund holistic development, with measurable before/after impact.",
    icon: "M3 21V9l6-5 6 5v12"
  },
  {
    title: "Employee Volunteering",
    desc: "Bring your team to the field — teaching, medical camps, and community days that build purpose and teamwork.",
    icon: "M12 21c-4 0-7-1.5-7-4.5S8 12 12 12s7 1.5 7 4.5S16 21 12 21z"
  },
  {
    title: "In-Kind Support",
    desc: "Contribute goods, services, or expertise — books, laptops, medical supplies, pro-bono skills.",
    icon: "M3 12l3-6h12l3 6-4 5H7l-4-5z"
  }
];
---

<BaseLayout title="Partner With Us" description={`Partner with ${SITE_INFO.name} for CSR and corporate partnerships`}>
  <!-- Page Hero -->
  <PageHero
    kicker="Get Involved"
    title="Partner With Us"
    description="Corporate Social Responsibility (CSR) partnerships that create tangible, measurable social impact."
    breadcrumbs={[
      { label: "Get Involved", href: "/get-involved" },
      { label: "Partner" }
    ]}
  />

  <!-- Why Partner -->
  <section class="section bg-paper">
    <div class="shell">
      <h2 class="text-3xl md:text-4xl text-ink mb-12 text-center font-display">Why Partner With Us</h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        {REASONS.map((reason) => (
          <div class="card p-7 text-center border border-line">
            <div class="w-14 h-14 bg-saffron/10 flex items-center justify-center mx-auto mb-5 text-saffron">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d={reason.icon} />
              </svg>
            </div>
            <h3 class="font-display text-lg mb-2">{reason.title}</h3>
            <p class="text-ink-soft text-sm leading-relaxed">{reason.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Partnership Models -->
  <section class="section bg-mist">
    <div class="shell">
      <h2 class="text-3xl md:text-4xl text-ink mb-12 text-center font-display">Partnership Models</h2>
      <div class="grid md:grid-cols-2 gap-7">
        {MODELS.map((model) => (
          <div class="card p-8 border border-line">
            <div class="w-12 h-12 bg-saffron/10 flex items-center justify-center mb-5 text-saffron">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d={model.icon} />
              </svg>
            </div>
            <h3 class="font-display text-xl mb-3">{model.title}</h3>
            <p class="text-ink-soft text-sm leading-relaxed">{model.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Contact CTA -->
  <section class="section bg-navy-deep text-center text-white">
    <div class="shell max-w-2xl">
      <h2 class="text-3xl md:text-4xl mb-4 font-display">Let's Create Impact Together</h2>
      <p class="text-paper/75 mb-8 leading-relaxed">
        Ready to partner with us? Reach out and we'll design a partnership that fits your CSR goals.
      </p>
      <a href="/contact" class="btn btn-accent">Contact for Partnership</a>
    </div>
  </section>
</BaseLayout>