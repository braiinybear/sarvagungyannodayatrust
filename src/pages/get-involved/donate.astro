---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Donate" description="Support Sarvagun Gyannodaya Trust - Your donation changes lives">
  <!-- Hero -->
  <section class="section bg-pine text-paper">
    <div class="shell max-w-3xl">
      <p class="kicker !text-saffron mb-5">Donate</p>
      <h1 class="text-4xl md:text-6xl mb-6">Your generosity becomes their future.</h1>
      <p class="text-xl text-paper/80">
        Every donation helps us empower communities through education, elderly care, and development.
      </p>
    </div>
  </section>

  <!-- Donation Impact -->
  <section class="section bg-paper">
    <div class="shell">
      <div class="mb-12 text-center">
        <p class="kicker justify-center mb-4">Where Your Money Goes</p>
        <h2 class="text-3xl md:text-5xl text-ink">Every rupee, accounted for</h2>
      </div>

      <div class="grid md:grid-cols-4 gap-x-8 gap-y-10">
        <div class="border-t border-line pt-6">
          <p class="font-display text-3xl text-pine mb-1">₹500</p>
          <p class="text-sm text-ink-soft">School supplies for five children for a month</p>
        </div>
        <div class="border-t border-line pt-6">
          <p class="font-display text-3xl text-pine mb-1">₹1,000</p>
          <p class="text-sm text-ink-soft">Health checkups for ten elders</p>
        </div>
        <div class="border-t border-line pt-6">
          <p class="font-display text-3xl text-pine mb-1">₹5,000</p>
          <p class="text-sm text-ink-soft">Digital literacy training for 20 students</p>
        </div>
        <div class="border-t border-line pt-6">
          <p class="font-display text-3xl text-pine mb-1">₹10,000</p>
          <p class="text-sm text-ink-soft">A village sanitation or livelihood project</p>
        </div>
      </div>

      <!-- Fund Allocation -->
      <div class="max-w-3xl mx-auto mt-16">
        <h3 class="font-display text-xl text-ink mb-6">Fund Allocation</h3>
        <div class="space-y-5">
          <div>
            <div class="flex justify-between text-sm font-semibold mb-1.5">
              <span>Programs &amp; Beneficiaries</span>
              <span class="text-pine">90%</span>
            </div>
            <div class="h-1 bg-mist">
              <div class="h-full bg-pine" style="width: 90%"></div>
            </div>
          </div>
          <div>
            <div class="flex justify-between text-sm font-semibold mb-1.5">
              <span>Administration</span>
              <span class="text-saffron">7%</span>
            </div>
            <div class="h-1 bg-mist">
              <div class="h-full bg-saffron" style="width: 7%"></div>
            </div>
          </div>
          <div>
            <div class="flex justify-between text-sm font-semibold mb-1.5">
              <span>Fundraising</span>
              <span class="text-ember">3%</span>
            </div>
            <div class="h-1 bg-mist">
              <div class="h-full bg-ember" style="width: 3%"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Donation Form -->
  <section class="section bg-mist">
    <div class="shell max-w-2xl">
      <div class="bg-white p-8 md:p-12">
        <h2 class="font-display text-3xl text-ink mb-8 text-center">Make a Donation</h2>

        <form id="donation-form" class="space-y-7">
          <!-- Donation Type toggle -->
          <div>
            <label class="block text-sm font-semibold mb-3">Donation Type</label>
            <div class="grid grid-cols-2 border border-line">
              <button type="button" id="toggle-monthly" class="donation-type px-4 py-3.5 font-bold text-[0.76rem] tracking-[0.14em] uppercase bg-pine text-paper transition-colors" data-type="monthly">
                Monthly
              </button>
              <button type="button" id="toggle-onetime" class="donation-type px-4 py-3.5 font-bold text-[0.76rem] tracking-[0.14em] uppercase bg-transparent text-ink-soft hover:text-ink transition-colors" data-type="one-time">
                One-time
              </button>
            </div>
          </div>

          <!-- Amount Selection -->
          <div>
            <div class="flex items-baseline justify-between mb-5">
              <label class="text-sm font-semibold">Select Amount</label>
              <p class="font-display text-3xl text-pine">₹<span id="amount-display">1,000</span></p>
            </div>

            <!-- Slider -->
            <input
              type="range"
              id="amount-slider"
              min="100"
              max="10000"
              step="100"
              value="1000"
              class="w-full h-1 appearance-none bg-line cursor-pointer mb-3 [&::-webkit-slider-thumb]:appearance-none [&::-webkit-slider-thumb]:w-4 [&::-webkit-slider-thumb]:h-4 [&::-webkit-slider-thumb]:bg-pine [&::-webkit-slider-thumb]:border-none [&::-moz-range-thumb]:w-4 [&::-moz-range-thumb]:h-4 [&::-moz-range-thumb]:border-none [&::-moz-range-thumb]:bg-pine"
            />
            <div class="flex justify-between text-[0.62rem] font-semibold tracking-[0.12em] uppercase text-ink-faint mb-6">
              <span>₹100</span>
              <span>₹1,000</span>
              <span>₹5,000</span>
              <span>₹10,000</span>
            </div>

            <div class="grid grid-cols-3 gap-2">
              <button type="button" class="donation-amount px-4 py-3 border border-line font-semibold text-sm hover:border-ink transition-colors" data-amount="500">₹500</button>
              <button type="button" class="donation-amount px-4 py-3 border border-line font-semibold text-sm hover:border-ink transition-colors" data-amount="1000">₹1,000</button>
              <button type="button" class="donation-amount px-4 py-3 border border-line font-semibold text-sm hover:border-ink transition-colors" data-amount="2500">₹2,500</button>
              <button type="button" class="donation-amount px-4 py-3 border border-line font-semibold text-sm hover:border-ink transition-colors" data-amount="5000">₹5,000</button>
              <button type="button" class="donation-amount px-4 py-3 border border-line font-semibold text-sm hover:border-ink transition-colors" data-amount="10000">₹10,000</button>
              <button type="button" class="donation-amount px-4 py-3 border border-line font-semibold text-sm hover:border-ink transition-colors" data-amount="custom">Custom</button>
            </div>
            <input
              type="number"
              id="custom-amount"
              name="custom_amount"
              placeholder="Enter a custom amount"
              class="w-full px-4 py-3 border border-line focus:outline-none focus:ring-2 focus:ring-pine/40 focus:border-pine hidden mt-3"
            />
            <input type="hidden" id="donation-amount" name="amount" value="1000" />
            <input type="hidden" id="donation-type" name="donation_type" value="monthly" />
          </div>

          <!-- Donor Info -->
          <div class="grid md:grid-cols-2 gap-4">
            <div>
              <label for="donor-name" class="block text-sm font-semibold mb-1">Full Name *</label>
              <input
                type="text"
                id="donor-name"
                name="name"
                required
                class="w-full px-4 py-3 border border-line focus:outline-none focus:ring-2 focus:ring-pine/40 focus:border-pine"
              />
            </div>
            <div>
              <label for="donor-email" class="block text-sm font-semibold mb-1">Email *</label>
              <input
                type="email"
                id="donor-email"
                name="email"
                required
                class="w-full px-4 py-3 border border-line focus:outline-none focus:ring-2 focus:ring-pine/40 focus:border-pine"
              />
            </div>
          </div>

          <div>
            <label for="donor-phone" class="block text-sm font-semibold mb-1">Phone</label>
            <input
              type="tel"
              id="donor-phone"
              name="phone"
              class="w-full px-4 py-3 border border-line focus:outline-none focus:ring-2 focus:ring-pine/40 focus:border-pine"
            />
          </div>

          <!-- Tax Receipt -->
          <div class="flex items-start gap-3">
            <input type="checkbox" id="tax-receipt" name="tax_receipt" class="mt-1.5" />
            <label for="tax-receipt" class="text-sm text-ink-soft">
              I would like a tax receipt under Section 80G. All donations are tax-exempt.
            </label>
          </div>

          <!-- Submit -->
          <button type="submit" class="btn btn-primary w-full !py-4 text-[0.8rem]">
            Donate Now
          </button>

          <p class="text-center text-ink-faint text-sm">
            Your donation is secure and encrypted. All donations are tax-exempt under Section 80G.
          </p>
        </form>
      </div>
    </div>
  </section>

  <!-- Other Ways to Give -->
  <section class="section bg-paper">
    <div class="shell">
      <h2 class="text-3xl md:text-4xl text-ink mb-12 text-center">Other Ways to Give</h2>
      <div class="grid md:grid-cols-3 gap-x-12 gap-y-10">
        <div>
          <div class="w-12 h-12 bg-pine flex items-center justify-center mb-5 text-paper">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
              <rect x="3" y="6" width="18" height="13" rx="2" />
              <path stroke-linecap="round" d="M3 10h18M8 15h4" />
            </svg>
          </div>
          <h3 class="font-display text-xl mb-3">Bank Transfer</h3>
          <p class="text-ink-soft text-sm mb-4">
            Direct bank transfer to our account. Contact us for details.
          </p>
          <a href="/contact" class="link-arrow">Get Bank Details</a>
        </div>
        <div>
          <div class="w-12 h-12 bg-saffron flex items-center justify-center mb-5 text-paper">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
              <rect x="6" y="2" width="12" height="20" rx="3" />
              <path stroke-linecap="round" d="M11 18h2" />
            </svg>
          </div>
          <h3 class="font-display text-xl mb-3">UPI</h3>
          <p class="text-ink-soft text-sm mb-4">
            Scan our QR code or use our UPI ID for instant donations.
          </p>
          <a href="/contact" class="link-arrow">Get UPI Details</a>
        </div>
        <div>
          <div class="w-12 h-12 bg-ember flex items-center justify-center mb-5 text-paper">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
              <path d="M3 12l3-6h12l3 6-4 5H7l-4-5z" />
              <path stroke-linecap="round" d="M3 12h18" />
            </svg>
          </div>
          <h3 class="font-display text-xl mb-3">In-Kind Support</h3>
          <p class="text-ink-soft text-sm mb-4">
            Donate goods, services, or expertise to our programs.
          </p>
          <a href="/contact" class="link-arrow">Learn More</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const amountButtons = document.querySelectorAll('.donation-amount');
  const slider = document.getElementById('amount-slider') as HTMLInputElement;
  const amountDisplay = document.getElementById('amount-display');
  const customAmountInput = document.getElementById('custom-amount') as HTMLInputElement;
  const amountHidden = document.getElementById('donation-amount') as HTMLInputElement;
  const typeHidden = document.getElementById('donation-type') as HTMLInputElement;
  const toggles = document.querySelectorAll('.donation-type');

  const fmt = (n: number) => n.toLocaleString('en-IN');

  const setActiveChip = (value: string) => {
    amountButtons.forEach(b => {
      const active = b.getAttribute('data-amount') === value;
      b.classList.toggle('border-ink', active);
      b.classList.toggle('bg-mist', active);
      b.classList.toggle('text-ink', active);
      b.classList.toggle('border-line', !active);
    });
  };

  const setSliderValue = (value: number) => {
    slider.value = String(Math.min(Math.max(value, Number(slider.min)), Number(slider.max)));
  };

  slider?.addEventListener('input', () => {
    const value = Number(slider.value);
    amountDisplay.textContent = fmt(value);
    amountHidden.value = String(value);
    customAmountInput?.classList.add('hidden');
    setActive('custom');
  });

  amountButtons.forEach(button => {
    button.addEventListener('click', () => {
      const amount = button.getAttribute('data-amount');
      setActive(amount);

      if (amount === 'custom') {
        customAmountInput?.classList.remove('hidden');
        customAmountInput?.focus();
        return;
      }

      customAmountInput?.classList.add('hidden');
      const value = Number(amount);
      amountDisplay.textContent = fmt(value);
      amountHidden.value = String(value);
      setSliderValue(value);
    });
  });

  customAmountInput?.addEventListener('input', () => {
    const value = Number(customAmountInput.value);
    if (value > 0) {
      amountDisplay.textContent = fmt(value);
      amountHidden.value = String(value);
    }
  });

  toggles.forEach(t => {
    t.addEventListener('click', () => {
      toggles.forEach(o => {
        o.classList.toggle('bg-pine', o === t);
        o.classList.toggle('text-paper', o === t);
        o.classList.toggle('text-ink-soft', o !== t);
        o.classList.toggle('hover:text-ink', o !== t);
        o.classList.remove('hover:bg-pine');
      });
      typeHidden.value = t.getAttribute('data-type') || 'monthly';
    });
  });

  const form = document.getElementById('donation-form') as HTMLFormElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    console.log('Donation form submitted');
    alert('Thank you for your donation! You will be redirected to the payment gateway.');
  });
</script>